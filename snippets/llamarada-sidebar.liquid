        <svg width="20" height="20" viewBox="0 0 22 19" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 15H17V13H15V15V15M15 9H17V7H15V9V9M5 9H7V7H5V9V9M5 15H7V13H5V15V15M10.05 0H11.95C11.95 0 11.95 3.02 14.1 3.52C16.25 4.02 17.65 1.87 17.65 1.87L19 3.22C19 3.22 16.85 4.62 17.35 6.77C17.85 8.92 20.87 8.92 20.87 8.92V10.82C20.87 10.82 17.85 10.82 17.35 12.97C16.85 15.12 19 16.52 19 16.52L17.65 17.87C17.65 17.87 16.25 15.72 14.1 16.22C11.95 16.72 11.95 19.74 11.95 19.74H10.05C10.05 19.74 10.05 16.72 7.9 16.22C5.75 15.72 4.35 17.87 4.35 17.87L3 16.52C3 16.52 5.15 15.12 4.65 12.97C4.15 10.82 1.13 10.82 1.13 10.82V8.92C1.13 8.92 4.15 8.92 4.65 6.77C5.15 4.62 3 3.22 3 3.22L4.35 1.87C4.35 1.87 5.75 4.02 7.9 3.52C10.05 3.02 10.05 0 10.05 0V0" fill="currentColor"/>
        </svg>
      </span>
      <span>Juguetes</span>
    </a>

    <a href="/collections/fiesta" class="ll-sidebar__nav-item{% if current_handle == 'fiesta' %} is-active{% endif %}">
