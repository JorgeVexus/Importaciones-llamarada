{%- assign current_handle = collection.handle -%}

<aside class="ll-sidebar" aria-label="Menú lateral de navegación mayorista">
  <!-- Top card CTA with single functional login button -->
  <div class="ll-sidebar__card">
    <h2 class="ll-sidebar__title">Importamos lo que necesitas</h2>
    <p class="ll-sidebar__subtitle">Venta por Mayoreo</p>
    
    {%- if customer -%}
      <div class="ll-sidebar__user-box">
        <a href="{{ routes.account_url }}" class="ll-sidebar__btn-login">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" fill="currentColor"/></svg>
          <span>Mi Cuenta</span>
        </a>
        <a href="{{ routes.account_logout_url }}" class="ll-sidebar__btn-logout">
          Cerrar Sesión
        </a>
      </div>
    {%- else -%}
      <a href="{{ routes.account_login_url }}" class="ll-sidebar__btn-login">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" fill="currentColor"/></svg>
        <span>Iniciar Sesión</span>
      </a>
    {%- endif -%}
  </div>

  <!-- Category Nav List with dynamic icons and fallbacks -->
  <nav class="ll-sidebar__nav" aria-label="Categorías">
    <a href="{{ routes.root_url }}" class="ll-sidebar__nav-item{% if request.page_type == 'index' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'inicio', size: 20 -%}</span>
      <span>Inicio</span>
    </a>
    <a href="/collections/hogar" class="ll-sidebar__nav-item{% if request.page_type == 'collection' and current_handle == 'hogar' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'hogar', size: 20 -%}</span>
      <span>Hogar</span>
    </a>
    <a href="/collections/juguetes" class="ll-sidebar__nav-item{% if request.page_type == 'collection' and current_handle == 'juguetes' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'juguetes', size: 20 -%}</span>
      <span>Juguetes</span>
    </a>
    <a href="/collections/cocina" class="ll-sidebar__nav-item{% if request.page_type == 'collection' and current_handle == 'cocina' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'cocina', size: 20 -%}</span>
      <span>Cocina</span>
    </a>
    <a href="/collections/articulos-de-limpieza" class="ll-sidebar__nav-item{% if request.page_type == 'collection' and current_handle contains 'limpieza' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'limpieza', size: 20 -%}</span>
      <span>Artículos de Limpieza</span>
    </a>
    <a href="/collections/bebes" class="ll-sidebar__nav-item{% if request.page_type == 'collection' and current_handle == 'bebes' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'bebes', size: 20 -%}</span>
      <span>Bebés</span>
    </a>
    <a href="/collections/abarrotes" class="ll-sidebar__nav-item{% if request.page_type == 'collection' and current_handle == 'abarrotes' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'abarrotes', size: 20 -%}</span>
      <span>Abarrotes</span>
    </a>
  </nav>

  <!-- Footer Links (Only Ayuda) -->
  <div class="ll-sidebar__footer-links">
    <a href="/pages/contact" class="ll-sidebar__footer-link{% if request.path == '/pages/contact' %} ll-footer__link--active{% endif %}">
      <span class="ll-sidebar__icon">
        {%- render 'llamarada-icon-helper', icon: 'ayuda', size: 18 -%}
      </span>
      <span>Ayuda</span>
    </a>
  </div>
</aside>
