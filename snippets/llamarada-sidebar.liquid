  <!-- Secondary Purple Login CTA -->
  <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="ll-sidebar__btn-purple">
    Iniciar Sesión
  </a>

  <!-- Footer Links -->
  <div class="ll-sidebar__footer-links">
    <a href="/blogs/news" class="ll-sidebar__footer-link">
      <span class="ll-sidebar__icon">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 0L12.25 6.75L19 9L12.25 11.25L10 18L7.75 11.25L1 9L7.75 6.75L10 0Z" fill="currentColor"/>
        </svg>
      </span>
      <span>Novedades</span>
    </a>

    <a href="/pages/contact" class="ll-sidebar__footer-link">
      <span class="ll-sidebar__icon">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 0C4.48 0 0 4.48 0 10C0 15.52 4.48 20 10 20C15.52 20 20 15.52 20 10C20 4.48 15.52 0 10 0ZM11 16H9V14H11V16ZM12.07 9.25L11.17 10.17C10.45 10.9 10 11.5 10 13H8V12.5C8 11.4 8.45 10.4 9.17 9.67L10.41 8.41C10.78 8.05 11 7.55 11 7C11 5.9 10.1 5 9 5C7.9 5 7 5.9 7 7H5C5 4.79 6.79 3 9 3C11.21 3 13 4.79 13 7C13 7.88 12.64 8.68 12.07 9.25Z" fill="currentColor"/>
