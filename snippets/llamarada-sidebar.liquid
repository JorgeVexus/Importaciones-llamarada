{%- comment -%}
  Llamarada Reusable Sidebar Navigation
  Usage: {% render 'llamarada-sidebar', active_handle: current_handle %}
{%- endcomment -%}

{%- assign current_handle = active_handle | default: collection.handle | default: 'hogar' -%}

<aside class="ll-sidebar" aria-label="Menú lateral de navegación mayorista">
  <!-- Top card CTA -->
  <div class="ll-sidebar__card">
    <h2 class="ll-sidebar__title">Importamos lo que necesitas</h2>
    <p class="ll-sidebar__subtitle">Venta por Mayoreo</p>
    <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="ll-sidebar__btn-login">
      Iniciar Sesión
    </a>
  </div>

  <!-- Category Nav List -->
  <nav class="ll-sidebar__nav" aria-label="Categorías">
    <a href="/collections/hogar" class="ll-sidebar__nav-item{% if current_handle == 'hogar' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">
        <img src="{{ 'icon-nav-hogar.svg' | asset_url }}" alt="Hogar" width="20" height="20">
      </span>
      <span>Hogar</span>
    </a>

    <a href="/collections/juguetes" class="ll-sidebar__nav-item{% if current_handle == 'juguetes' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">
        <img src="{{ 'icon-nav-juguetes.svg' | asset_url }}" alt="Juguetes" width="20" height="20">
      </span>
      <span>Juguetes</span>
    </a>

    <a href="/collections/fiesta" class="ll-sidebar__nav-item{% if current_handle == 'fiesta' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">
        <img src="{{ 'icon-nav-fiesta.svg' | asset_url }}" alt="Fiesta" width="20" height="20">
      </span>
      <span>Fiesta</span>
    </a>

    <a href="/collections/belleza" class="ll-sidebar__nav-item{% if current_handle == 'belleza' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">
        <img src="{{ 'icon-nav-belleza.svg' | asset_url }}" alt="Belleza" width="20" height="20">
      </span>
      <span>Belleza</span>
    </a>

    <a href="/collections/cocina" class="ll-sidebar__nav-item{% if current_handle == 'cocina' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">
        <img src="{{ 'icon-nav-cocina.svg' | asset_url }}" alt="Cocina" width="20" height="20">
      </span>
      <span>Cocina</span>
    </a>

    <a href="/collections/limpieza" class="ll-sidebar__nav-item{% if current_handle == 'limpieza' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">
        <img src="{{ 'icon-nav-limpieza.svg' | asset_url }}" alt="Limpieza" width="20" height="20">
      </span>
      <span>Limpieza</span>
    </a>

    <a href="/collections/bebes" class="ll-sidebar__nav-item{% if current_handle == 'bebes' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">
        <img src="{{ 'icon-nav-bebes.svg' | asset_url }}" alt="Bebés" width="20" height="20">
      </span>
      <span>Bebés</span>
    </a>

    <a href="/collections/abarrotes" class="ll-sidebar__nav-item{% if current_handle == 'abarrotes' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">
        <img src="{{ 'icon-nav-abarrotes.svg' | asset_url }}" alt="Abarrotes" width="20" height="20">
      </span>
      <span>Abarrotes</span>
    </a>
  </nav>

  <!-- Secondary Purple Login CTA -->
  <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="ll-sidebar__btn-purple">
    Iniciar Sesión
  </a>

  <!-- Footer Links -->
  <div class="ll-sidebar__footer-links">
    <a href="/blogs/news" class="ll-sidebar__footer-link">
      <span class="ll-sidebar__icon">
        <img src="{{ 'icon-nav-novedades.svg' | asset_url }}" alt="Novedades" width="20" height="20">
      </span>
      <span>Novedades</span>
    </a>

    <a href="/pages/contact" class="ll-sidebar__footer-link">
      <span class="ll-sidebar__icon">
        <img src="{{ 'icon-nav-ayuda.svg' | asset_url }}" alt="Ayuda" width="20" height="20">
      </span>
      <span>Ayuda</span>
    </a>
  </div>
</aside>
