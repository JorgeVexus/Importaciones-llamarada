{%- comment -%}
  Llamarada Reusable Sidebar Navigation
  Usage: {% render 'llamarada-sidebar', active_handle: current_handle %}
{%- endcomment -%}

{%- assign current_handle = active_handle | default: collection.handle | default: 'hogar' -%}

<aside class="ll-sidebar" aria-label="Menú lateral de navegación mayorista">
  <!-- Top card CTA -->
  <div class="ll-sidebar__card">
    <h2 class="ll-sidebar__title">Importamos lo que necesitas</h2>
    <p class="ll-sidebar__subtitle">Venta por Mayoreo</p>
    <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="ll-sidebar__btn-login">
      Iniciar Sesión
    </a>
  </div>

  <!-- Category Nav List -->
  <nav class="ll-sidebar__nav" aria-label="Categorías">
    <a href="/collections/hogar" class="ll-sidebar__nav-item{% if current_handle == 'hogar' %} is-active{% endif %}">
      <span class="ll-sidebar__icon">
        <svg width="20" height="20" viewBox="0 0 22 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 6H18V4H16V6V6M16 10H18V8H16V10V10M16 14H18V12H16V14V14M16 18V16H20V2H11V3.4L9 1.95V0H22V18H16V18M0 18V8L7 3L14 8V18H8V13H6V18H0V18M2 16H4V11H10V16H12V9L7 5.45L2 9V16V16M16 7V7V7V7V7V7V7V7M10 16V16V11H4V16V16V11H7H10V16V16" fill="currentColor"/>
        </svg>
      </span>
      <span>Hogar</span>
    </a>

    <a href="/collections/juguetes" class="ll-sidebar__nav-item{% if current_handle == 'juguetes' %} is-active{% endif %}">
