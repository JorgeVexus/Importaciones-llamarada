{%- assign selected_product = section.settings.product -%}

<div class="ll-new-spotlight-sec">
  <div class="ll-new-spotlight-sec__container">
    <div class="ll-new-spotlight-sec__grid">
      <!-- Media Wrap -->
      <div class="ll-new-spotlight-sec__media-wrap">
        {%- if section.settings.badge_text != blank -%}
          <div class="ll-new-spotlight-sec__badge">
            <span>{{ section.settings.badge_text }}</span>
          </div>
        {%- endif -%}

        <div class="ll-new-spotlight-sec__media">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title }}" loading="lazy" width="800" height="600">
          {%- elsif selected_product != blank and selected_product.featured_image != blank -%}
            <img src="{{ selected_product.featured_image | image_url: width: 800 }}" alt="{{ selected_product.title }}" loading="lazy" width="800" height="600">
          {%- else -%}
            <img src="{{ 'novedades_spotlight.png' | asset_url }}" alt="Spotlight Novedad" loading="lazy" width="800" height="600">
          {%- endif -%}
        </div>
      </div>

      <!-- Copy & Actions Wrap -->
      <div class="ll-new-spotlight-sec__copy">
        <span class="ll-new-spotlight-sec__tag">{{ section.settings.tagline | default: 'Lanzamiento Estrella' }}</span>
        
        <h2 class="ll-new-spotlight-sec__title">
          {{ section.settings.title | default: selected_product.title | default: 'Vasos Foco Neón LED (Caja con 100 pzas)' }}
        </h2>

        <p class="ll-new-spotlight-sec__desc">
          {{ section.settings.description | default: selected_product.description | strip_html | truncatewords: 35 | default: 'Increíbles vasos con iluminación LED multicolor y sorbete flexible. Ideal para eventos, fiestas y venta al detalle. Alta rotación comercial.' }}
        </p>

        <!-- Pricing info -->
        <div class="ll-new-spotlight-sec__pricing">
          <div class="ll-new-spotlight-sec__price-main">
            <span class="ll-new-spotlight-sec__unit-price">
              {%- if selected_product != blank -%}
                {{ selected_product.price | money }}
              {%- else -%}
                {{ section.settings.price | default: '$1,850.00 MXN' }}
              {%- endif -%}
            </span>
            {%- if section.settings.compare_price != blank or selected_product.compare_at_price > selected_product.price -%}
              <span class="ll-new-spotlight-sec__compare-price">
                {%- if selected_product != blank and selected_product.compare_at_price > selected_product.price -%}
                  {{ selected_product.compare_at_price | money }}
                {%- else -%}
                  {{ section.settings.compare_price | default: '$2,400.00 MXN' }}
                {%- endif -%}
              </span>
            {%- endif -%}
          </div>
          
          <div class="ll-new-spotlight-sec__wholesale-detail">
            <span class="ll-new-spotlight-sec__box-badge">{{ section.settings.unit_detail | default: '($18.50 / pza • Caja x 100 pzas)' }}</span>
          </div>
        </div>

        <!-- Actions -->
        <div class="ll-new-spotlight-sec__actions">
          <a href="{{ section.settings.button_url | default: selected_product.url | default: '/collections/all' }}" class="ll-new-spotlight-sec__btn-primary">
            <span>{{ section.settings.button_text | default: 'Ver Producto Destacado' }}</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>

        <!-- Stock Status -->
        <div class="ll-new-spotlight-sec__stock">
          <span class="ll-new-spotlight-sec__stock-dot"></span>
          <span>{{ section.settings.stock_text | default: 'Stock disponible para envío inmediato en contenedor' }}</span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Novedades - Spotlight",
  "class": "section-llamarada-new-arrivals-spotlight",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Producto destacado (opcional)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen personalizada (sobrescribe imagen del producto)"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge superior",
      "default": "¡Exclusiva!"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Subetiqueta",
      "default": "Lanzamiento Estrella"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título de la novedad estrella",
      "default": "Vasos Foco Neón LED (Caja con 100 pzas)"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción corta",
      "default": "Increíbles vasos con iluminación LED multicolor y sorbete flexible. Ideal para eventos, fiestas y venta al detalle. Alta rotación comercial."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Precio manual (si no selecciona producto)",
      "default": "$1,850.00 MXN"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Precio tachado manual",
      "default": "$2,400.00 MXN"
    },
    {
      "type": "text",
      "id": "unit_detail",
      "label": "Detalle de empaque / precio unitario",
      "default": "($18.50 / pza • Caja x 100 pzas)"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "Ver Producto Destacado"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Enlace del botón"
    },
    {
      "type": "text",
      "id": "stock_text",
      "label": "Mensaje de inventario",
      "default": "Stock disponible para envío inmediato en contenedor"
    }
  ],
  "presets": [
    {
      "name": "Novedades - Spotlight"
    }
  ]
}
{% endschema %}
