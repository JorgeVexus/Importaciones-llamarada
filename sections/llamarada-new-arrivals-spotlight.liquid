{%- assign selected_product = section.settings.product -%}

{%- assign spotlight_title = selected_product.title -%}
{%- if spotlight_title == blank or section.settings.title != blank and section.settings.title != 'Vasos Foco Neón LED (Caja con 100 pzas)' -%}
  {%- if section.settings.title != blank -%}
    {%- assign spotlight_title = section.settings.title -%}
  {%- else -%}
    {%- assign spotlight_title = 'Vasos Foco Neón LED (Caja con 100 pzas)' -%}
  {%- endif -%}
{%- endif -%}

{%- assign spotlight_desc = selected_product.description | strip_html | truncatewords: 35 -%}
{%- if spotlight_desc == blank or section.settings.description != blank and section.settings.description != 'Increíbles vasos con iluminación LED multicolor y sorbete flexible. Ideal para eventos, fiestas y venta al detalle. Alta rotación comercial.' -%}
  {%- if section.settings.description != blank -%}
    {%- assign spotlight_desc = section.settings.description -%}
  {%- else -%}
    {%- assign spotlight_desc = 'Increíbles vasos con iluminación LED multicolor y sorbete flexible. Ideal para eventos, fiestas y venta al detalle. Alta rotación comercial.' -%}
  {%- endif -%}
{%- endif -%}

{%- assign spotlight_price = selected_product.price | money -%}
{%- if selected_product == blank -%}
  {%- assign spotlight_price = section.settings.price | default: '$1,850.00 MXN' -%}
{%- elsif section.settings.price != blank and section.settings.price != '$1,850.00 MXN' -%}
  {%- assign spotlight_price = section.settings.price -%}
{%- endif -%}

{%- assign spotlight_compare = '' -%}
{%- if selected_product != blank and selected_product.compare_at_price > selected_product.price -%}
  {%- assign spotlight_compare = selected_product.compare_at_price | money -%}
{%- elsif section.settings.compare_price != blank and section.settings.compare_price != '$2,400.00 MXN' -%}
  {%- assign spotlight_compare = section.settings.compare_price -%}
{%- elsif selected_product == blank -%}
  {%- assign spotlight_compare = section.settings.compare_price | default: '$2,400.00 MXN' -%}
{%- endif -%}

{%- assign spotlight_url = selected_product.url -%}
{%- if spotlight_url == blank or section.settings.button_url != blank -%}
  {%- assign spotlight_url = section.settings.button_url | default: '/collections/all' -%}
{%- endif -%}

<div class="ll-new-spotlight-sec">
  <div class="ll-new-spotlight-sec__container">
    <div class="ll-new-spotlight-sec__grid">
      <!-- Media Wrap -->
      <div class="ll-new-spotlight-sec__media-wrap">
        {%- if section.settings.badge_text != blank -%}
          <div class="ll-new-spotlight-sec__badge">
            <span>{{ section.settings.badge_text }}</span>
          </div>
        {%- endif -%}

        <div class="ll-new-spotlight-sec__media">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ spotlight_title | escape }}" loading="lazy" width="800" height="600">
          {%- elsif selected_product != blank and selected_product.featured_image != blank -%}
            <img src="{{ selected_product.featured_image | image_url: width: 800 }}" alt="{{ spotlight_title | escape }}" loading="lazy" width="800" height="600">
          {%- else -%}
            <img src="{{ 'novedades_spotlight.png' | asset_url }}" alt="Spotlight Novedad" loading="lazy" width="800" height="600">
          {%- endif -%}
        </div>
      </div>

      <!-- Copy & Actions Wrap -->
      <div class="ll-new-spotlight-sec__copy">
        <span class="ll-new-spotlight-sec__tag">{{ section.settings.tagline | default: 'Lanzamiento Estrella' }}</span>
        
        <h2 class="ll-new-spotlight-sec__title">
          {{ spotlight_title }}
        </h2>

        <p class="ll-new-spotlight-sec__desc">
          {{ spotlight_desc }}
        </p>

        <!-- Pricing info -->
        <div class="ll-new-spotlight-sec__pricing">
          <div class="ll-new-spotlight-sec__price-main">
            <span class="ll-new-spotlight-sec__unit-price">
              {{ spotlight_price }}
            </span>
            {%- if spotlight_compare != blank -%}
              <span class="ll-new-spotlight-sec__compare-price">
                {{ spotlight_compare }}
              </span>
            {%- endif -%}
          </div>
          
          <div class="ll-new-spotlight-sec__wholesale-detail">
            <span class="ll-new-spotlight-sec__box-badge">{{ section.settings.unit_detail | default: '($18.50 / pza • Caja x 100 pzas)' }}</span>
          </div>
        </div>

        <!-- Actions -->
        <div class="ll-new-spotlight-sec__actions">
          <a href="{{ spotlight_url }}" class="ll-new-spotlight-sec__btn-primary">
            <span>{{ section.settings.button_text | default: 'Ver Producto Destacado' }}</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>

        <!-- Stock Status -->
        <div class="ll-new-spotlight-sec__stock">
          <span class="ll-new-spotlight-sec__stock-dot"></span>
          <span>{{ section.settings.stock_text | default: 'Stock disponible para envío inmediato en contenedor' }}</span>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Novedades - Spotlight",
  "class": "section-llamarada-new-arrivals-spotlight",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Producto destacado (carga datos automáticamente)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen personalizada (opcional, sobrescribe imagen del producto)"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge superior",
      "default": "¡Exclusiva!"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Subetiqueta",
      "default": "Lanzamiento Estrella"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título personalizado (opcional si selecciona producto)"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción personalizada (opcional si selecciona producto)"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Precio manual (opcional si selecciona producto)"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Precio tachado manual (opcional si selecciona producto)"
    },
    {
      "type": "text",
      "id": "unit_detail",
      "label": "Detalle de empaque / precio unitario",
      "default": "($18.50 / pza • Caja x 100 pzas)"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "Ver Producto Destacado"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Enlace personalizado (opcional)"
    },
    {
      "type": "text",
      "id": "stock_text",
      "label": "Mensaje de inventario",
      "default": "Stock disponible para envío inmediato en contenedor"
    }
  ],
  "presets": [
    {
      "name": "Novedades - Spotlight"
    }
  ]
}
{% endschema %}
