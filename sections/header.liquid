<header class="ll-header" style="background-color: {{ section.settings.header_bg_color | default: '#ffffff' }}; border-bottom-color: {{ section.settings.header_bg_color | default: '#ffffff' }};">
  <div class="ll-header__container">
    <div class="ll-header__top">
      <!-- Brand Logo -->
      <a href="{{ routes.root_url }}" class="ll-header__brand" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 300 }}"
            alt="{{ shop.name }}"
            class="ll-header__logo-img"
            loading="eager"
            width="{{ section.settings.logo_width | default: 220 }}"
            height="auto"
          >
        {%- else -%}
          <img
            src="{{ 'llamarada-logo.png' | asset_url }}"
            alt="La Llamarada - Importaciones"
            class="ll-header__logo-img"
            loading="eager"
            width="220"
            height="55"
          >
        {%- endif -%}
      </a>

      <!-- Search Input Bar -->
      <div class="ll-header__search-wrap">
        <form action="{{ routes.search_url }}" method="get" role="search" class="ll-header__search-form">
          <input
            type="search"
            name="q"
            id="ll-header-search"
            class="ll-header__search-input"
            placeholder="{{ section.settings.search_placeholder | default: 'Buscar productos por mayoreo...' }}"
            value="{{ search.terms | escape }}"
            autocomplete="off"
          >
          <button type="submit" class="ll-header__search-btn" aria-label="Buscar">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12.5 11H11.71L11.43 10.73C12.41 9.59 13 8.11 13 6.5C13 2.91 10.09 0 6.5 0C2.91 0 0 2.91 0 6.5C0 10.09 2.91 13 6.5 13C8.11 13 9.59 12.41 10.73 11.43L11 11.71V12.5L16 17.49L17.49 16L12.5 11ZM6.5 11C4.01 11 2 8.99 2 6.5C2 4.01 4.01 2 6.5 2C8.99 2 11 4.01 11 6.5C11 8.99 8.99 11 6.5 11Z" fill="#9424A4"/>
            </svg>
          </button>
        </form>
      </div>

      <!-- Action Buttons -->
      <div class="ll-header__actions">
        <!-- Cart -->
        <a href="{{ routes.cart_url }}" class="ll-header__action-btn" id="ll-cart-icon-bubble" aria-label="Carrito de compras">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7 18C5.9 18 5.01 18.9 5.01 20C5.01 21.1 5.9 22 7 22C8.1 22 9 21.1 9 20C9 18.9 8.1 18 7 18ZM1 2V4H3L6.6 11.59L5.25 14.04C5.09 14.32 5 14.65 5 15C5 16.1 5.9 17 7 17H19V15H7.42C7.28 15 7.17 14.89 7.17 14.75L7.2 14.63L8.1 13H15.55C16.3 13 16.96 12.59 17.3 11.97L20.88 5.48C20.96 5.34 21 5.17 21 5C21 4.45 20.55 4 20 4H5.21L4.27 2H1ZM17 18C15.9 18 15.01 18.9 15.01 20C15.01 21.1 15.9 22 17 22C18.1 22 19 21.1 19 20C19 18.9 18.1 18 17 18Z" fill="#9424A4"/>
          </svg>
          <span class="ll-header__badge" id="ll-cart-count">
            {%- if cart.item_count > 0 -%}
              {{ cart.item_count }}
            {%- else -%}
              3
            {%- endif -%}
          </span>
        </a>

        <!-- User / Account -->
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="ll-header__action-btn" aria-label="Mi Cuenta">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 5C13.66 5 15 6.34 15 8C15 9.66 13.66 11 12 11C10.34 11 9 9.66 9 8C9 6.34 10.34 5 12 5ZM12 19.2C9.3 19.2 6.9 17.8 5.6 15.7C5.63 13.57 9.9 12.4 12 12.4C14.09 12.4 18.36 13.57 18.4 15.7C17.1 17.8 14.7 19.2 12 19.2Z" fill="#9424A4"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Sub-navigation row with Apple-style Dropdowns -->
    <nav class="ll-header__nav" aria-label="Categorías principales">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          {%- assign is_hdr_active = false -%}
          {%- assign link_h = link.object.handle | default: link.title | handleize -%}
          {%- assign has_dropdown = false -%}
          {%- if link.links != blank and link.links.size > 0 -%}
            {%- assign has_dropdown = true -%}
          {%- endif -%}

          {%- if request.page_type == 'index' -%}
            {%- if link.url == '/' or link.url == routes.root_url or link_h == 'inicio' -%}
              {%- assign is_hdr_active = true -%}
            {%- endif -%}
          {%- elsif request.page_type == 'collection' -%}
            {%- if collection.handle != blank -%}
              {%- if collection.handle == link_h or link.url contains collection.handle -%}
                {%- assign is_hdr_active = true -%}
              {%- endif -%}
              {%- if has_dropdown -%}
                {%- for child in link.links -%}
                  {%- assign child_h = child.object.handle | default: child.title | handleize -%}
                  {%- if collection.handle == child_h or child.url contains collection.handle -%}
                    {%- assign is_hdr_active = true -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endif -%}
          {%- elsif link.active or link.current -%}
            {%- assign is_hdr_active = true -%}
          {%- endif -%}

          {%- if has_dropdown -%}
            <div class="ll-header__dropdown-wrapper">
              <a
                href="{{ link.url }}"
                class="ll-header__nav-link ll-header__nav-link--has-dropdown{% if is_hdr_active %} is-active{% endif %}"
                aria-haspopup="true"
                aria-expanded="false"
              >
                {%- if link_h == 'inicio' or forloop.first and link.url == '/' or link.url == routes.root_url -%}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 6px; vertical-align: middle; display: inline-block;">
                    <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" fill="currentColor"/>
                  </svg>
                {%- endif -%}
                <span>{{ link.title }}</span>
                <svg class="ll-header__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <div class="ll-header__dropdown" role="menu">
                <div class="ll-header__dropdown-inner">
                  {%- for child_link in link.links -%}
                    {%- assign child_h = child_link.object.handle | default: child_link.title | handleize -%}
                    {%- assign is_child_active = false -%}
                    {%- if request.page_type == 'collection' and collection.handle != blank and collection.handle == child_h -%}
                      {%- assign is_child_active = true -%}
                    {%- elsif child_link.active or child_link.current -%}
                      {%- assign is_child_active = true -%}
                    {%- endif -%}
                    <a href="{{ child_link.url }}" class="ll-header__dropdown-item{% if is_child_active %} is-active{% endif %}" role="menuitem">
                      <span class="ll-header__dropdown-icon">
                        {%- render 'llamarada-icon-helper', icon: child_h, size: 16 -%}
                      </span>
                      <span class="ll-header__dropdown-label">{{ child_link.title }}</span>
                    </a>
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- else -%}
            <a
              href="{{ link.url }}"
              class="ll-header__nav-link{% if is_hdr_active %} is-active{% endif %}"
            >
              {%- if link_h == 'inicio' or forloop.first and link.url == '/' or link.url == routes.root_url -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 6px; vertical-align: middle; display: inline-block;">
                  <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" fill="currentColor"/>
                </svg>
              {%- endif -%}
              <span>{{ link.title }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}" class="ll-header__nav-link{% if request.page_type == 'index' %} is-active{% endif %}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 6px; vertical-align: middle; display: inline-block;">
            <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" fill="currentColor"/>
          </svg>
          <span>Inicio</span>
        </a>
        <a href="/collections/hogar" class="ll-header__nav-link{% if request.page_type == 'collection' and collection.handle == 'hogar' %} is-active{% endif %}">Hogar</a>
        <a href="/collections/juguetes" class="ll-header__nav-link{% if request.page_type == 'collection' and collection.handle == 'juguetes' %} is-active{% endif %}">Juguetes</a>
        <a href="/collections/fiesta" class="ll-header__nav-link{% if request.page_type == 'collection' and collection.handle == 'fiesta' %} is-active{% endif %}">Fiesta</a>
        <a href="/collections/belleza" class="ll-header__nav-link{% if request.page_type == 'collection' and collection.handle == 'belleza' %} is-active{% endif %}">Belleza</a>
        <a href="/collections/cocina" class="ll-header__nav-link{% if request.page_type == 'collection' and collection.handle == 'cocina' %} is-active{% endif %}">Cocina</a>
        <a href="/collections/bebes" class="ll-header__nav-link{% if request.page_type == 'collection' and collection.handle == 'bebes' %} is-active{% endif %}">Bebés</a>
        <a href="/collections/abarrotes" class="ll-header__nav-link{% if request.page_type == 'collection' and collection.handle == 'abarrotes' %} is-active{% endif %}">Abarrotes</a>
      {%- endif -%}
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Color de fondo del Header",
      "default": "#9424a4"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo de la tienda"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 300,
      "step": 10,
      "default": 220,
      "unit": "px",
      "label": "Ancho del logo"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder del buscador",
      "default": "Buscar productos por mayoreo..."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de navegación"
    }
  ]
}
{% endschema %}
