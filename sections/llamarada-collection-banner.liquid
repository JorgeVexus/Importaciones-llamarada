<section class="ll-category-hero" aria-label="{{ collection.title | default: section.settings.fallback_title | default: 'Limpieza' }}">
  {%- if section.settings.banner_image != blank -%}
    <img
      src="{{ section.settings.banner_image | image_url: width: 1400 }}"
      alt="{{ collection.title | escape }}"
      class="ll-category-hero__bg"
      loading="eager"
      width="1400"
      height="256"
    >
  {%- elsif collection.image != blank -%}
    <img
      src="{{ collection.image | image_url: width: 1400 }}"
      alt="{{ collection.title | escape }}"
      class="ll-category-hero__bg"
      loading="eager"
      width="1400"
      height="256"
    >
  {%- else -%}
    <img
      src="{{ 'cat-banner-limpieza.png' | asset_url }}"
      alt="{{ collection.title | default: 'Limpieza' }}"
      class="ll-category-hero__bg"
      loading="eager"
      width="1400"
      height="256"
    >
  {%- endif -%}

  <div class="ll-category-hero__overlay">
    <h1 class="ll-category-hero__title">
      {{ collection.title | default: section.settings.fallback_title | default: 'Limpieza' }}
    </h1>
    <p class="ll-category-hero__subtitle">
      {%- if collection.description != blank -%}
        {{ collection.description | strip_html }}
      {%- else -%}
        {{ section.settings.fallback_subtitle | default: 'Soluciones efectivas para un entorno impecable. Calidad industrial a tu alcance.' }}
      {%- endif -%}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Banner de Categoría",
  "class": "section-llamarada-collection-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Imagen de banner personalizada"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Título de respaldo",
      "default": "Limpieza"
    },
    {
      "type": "textarea",
      "id": "fallback_subtitle",
      "label": "Subtítulo de respaldo",
      "default": "Soluciones efectivas para un entorno impecable. Calidad industrial a tu alcance."
    }
  ],
  "presets": [
    {
      "name": "Banner de Categoría"
    }
  ]
}
{% endschema %}
