{% schema %}
{
  "name": "Barra Lateral (Sidebar)",
  "class": "section-llamarada-sidebar",
  "settings": [
    {
      "type": "text",
      "id": "card_title",
      "label": "Título de tarjeta superior",
      "default": "Importamos lo que necesitas"
    },
    {
      "type": "text",
      "id": "card_subtitle",
      "label": "Subtítulo de tarjeta superior",
      "default": "Venta por Mayoreo"
    },
    {
      "type": "text",
      "id": "login_btn_text",
      "label": "Texto del botón de iniciar sesión",
      "default": "Iniciar Sesión"
    },
    {
      "type": "url",
      "id": "login_link",
      "label": "Enlace del botón de iniciar sesión (vacío para URL por defecto)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de categorías de la tienda"
    },
    {
      "type": "text",
      "id": "news_text",
      "label": "Texto enlace Novedades",
      "default": "Novedades"
    },
    {
      "type": "url",
      "id": "news_link",
      "label": "Enlace Novedades"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Texto enlace Ayuda",
      "default": "Ayuda"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Enlace Ayuda"
    }
  ],
  "blocks": [
    {
      "type": "category_item",
      "name": "Categoría de Menú",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección asociada"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título visual personalizado (opcional)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Enlace alternativo"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icono o imagen personalizada (subir desde computadora)"
        },
        {
          "type": "select",
          "id": "icon_preset",
          "label": "Icono de categoría",
          "options": [
            { "value": "auto", "label": "Automático (según nombre de colección)" },
            { "value": "inicio", "label": "Inicio" },
            { "value": "hogar", "label": "Hogar" },
            { "value": "decoracion", "label": "Decoración" },
            { "value": "juguetes", "label": "Juguetes" },
            { "value": "fiesta", "label": "Fiesta" },
            { "value": "belleza", "label": "Belleza" },
            { "value": "cocina", "label": "Cocina" },
            { "value": "limpieza", "label": "Limpieza" },
            { "value": "bebes", "label": "Bebés" },
            { "value": "abarrotes", "label": "Abarrotes" },
            { "value": "mascotas", "label": "Mascotas" },
            { "value": "ropa", "label": "Ropa / Moda" },
            { "value": "electronica", "label": "Electrónica" },
            { "value": "papeleria", "label": "Papelería" },
            { "value": "ferreteria", "label": "Ferretería" }
          ],
          "default": "auto"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Marcar como activa por defecto",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra Lateral (Sidebar)",
      "blocks": [
        { "type": "category_item", "settings": { "title": "Hogar", "icon_preset": "hogar" } },
        { "type": "category_item", "settings": { "title": "Juguetes", "icon_preset": "juguetes" } },
        { "type": "category_item", "settings": { "title": "Cocina", "icon_preset": "cocina" } },
        { "type": "category_item", "settings": { "title": "Artículos de Limpieza", "icon_preset": "limpieza" } },
        { "type": "category_item", "settings": { "title": "Bebés", "icon_preset": "bebes" } },
        { "type": "category_item", "settings": { "title": "Abarrotes", "icon_preset": "abarrotes" } }
      ]
    }
  ]
}
{% endschema %}
