{%- assign current_handle = collection.handle -%}
{%- assign nav_menu = section.settings.menu -%}

<aside class="ll-sidebar" aria-label="Menú lateral de navegación mayorista">
  <!-- Top card CTA with single functional login button -->
  <div class="ll-sidebar__card">
    <h2 class="ll-sidebar__title">{{ section.settings.card_title | default: 'Importamos lo que necesitas' }}</h2>
    <p class="ll-sidebar__subtitle">{{ section.settings.card_subtitle | default: 'Venta por Mayoreo' }}</p>
    
    {%- if customer -%}
      <div class="ll-sidebar__user-box">
        <a href="{{ routes.account_url }}" class="ll-sidebar__btn-login">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" fill="currentColor"/></svg>
          <span>Mi Cuenta</span>
        </a>
        <a href="{{ routes.account_logout_url }}" class="ll-sidebar__btn-logout">
          Cerrar Sesión
        </a>
      </div>
    {%- else -%}
      <a href="{{ section.settings.login_link | default: routes.account_login_url }}" class="ll-sidebar__btn-login">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" fill="currentColor"/></svg>
        <span>{{ section.settings.login_btn_text | default: 'Iniciar Sesión' }}</span>
      </a>
    {%- endif -%}
  </div>

  <!-- Category Nav List with Apple Design Dropdowns -->
  <nav class="ll-sidebar__nav" aria-label="Categorías">
    {%- if nav_menu != blank and linklists[nav_menu].links.size > 0 -%}
      {%- for link in linklists[nav_menu].links -%}
        {%- assign link_handle = link.object.handle | default: link.title | handleize -%}
        {%- assign is_link_active = false -%}
        {%- assign has_active_child = false -%}
        
        {%- if link.links != blank and link.links.size > 0 -%}
          {%- for child in link.links -%}
            {%- assign child_h = child.object.handle | default: child.title | handleize -%}
            {%- if request.page_type == 'collection' and current_handle != blank and current_handle == child_h -%}
              {%- assign has_active_child = true -%}
            {%- elsif child.active or child.current -%}
              {%- assign has_active_child = true -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if request.page_type == 'index' -%}
          {%- if link.url == '/' or link.url == routes.root_url or link_handle == 'inicio' -%}
            {%- assign is_link_active = true -%}
          {%- endif -%}
        {%- elsif request.page_type == 'collection' -%}
          {%- if current_handle != blank and current_handle == link_handle -%}
            {%- assign is_link_active = true -%}
          {%- elsif link.active and link.url != '/' and link.url != routes.root_url -%}
            {%- assign is_link_active = true -%}
          {%- endif -%}
        {%- else -%}
          {%- if link.active and link.url != '/' and link.url != routes.root_url -%}
            {%- assign is_link_active = true -%}
          {%- endif -%}
        {%- endif -%}

        {%- if link.links != blank and link.links.size > 0 -%}
          <!-- Apple Style Collapsible Accordion Dropdown -->
          <details class="ll-sidebar__details"{% if is_link_active or has_active_child %} open{% endif %}>
            <summary class="ll-sidebar__summary{% if is_link_active or has_active_child %} is-active{% endif %}">
              <span class="ll-sidebar__icon">
                {%- render 'llamarada-icon-helper', icon: link_handle, size: 20 -%}
              </span>
              <span class="ll-sidebar__summary-title">{{ link.title }}</span>
              <svg class="ll-sidebar__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="ll-sidebar__sublist">
              {%- for child_link in link.links -%}
                {%- assign child_handle = child_link.object.handle | default: child_link.title | handleize -%}
                {%- assign is_child_active = false -%}
                {%- if request.page_type == 'collection' and current_handle != blank and current_handle == child_handle -%}
                  {%- assign is_child_active = true -%}
                {%- elsif child_link.active or child_link.current -%}
                  {%- assign is_child_active = true -%}
                {%- endif -%}
                <a href="{{ child_link.url }}" class="ll-sidebar__subitem{% if is_child_active %} is-active{% endif %}">
                  <span class="ll-sidebar__subicon">
                    {%- render 'llamarada-icon-helper', icon: child_handle, size: 16 -%}
                  </span>
                  <span>{{ child_link.title }}</span>
                </a>
              {%- endfor -%}
            </div>
          </details>
        {%- else -%}
          <a href="{{ link.url }}" class="ll-sidebar__nav-item{% if is_link_active %} is-active{% endif %}">
            <span class="ll-sidebar__icon">
              {%- render 'llamarada-icon-helper', icon: link_handle, size: 20 -%}
            </span>
            <span>{{ link.title }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}

    {%- elsif section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign block_collection = block.settings.collection -%}
        {%- assign cat_handle = block_collection.handle | default: block.settings.title | handleize -%}
        {%- assign active_icon = block.settings.icon_preset -%}
        {%- if active_icon == blank or active_icon == 'auto' -%}
          {%- assign active_icon = cat_handle -%}
        {%- endif -%}
        {%- assign is_block_active = false -%}
        
        {%- if request.page_type == 'index' -%}
          {%- if cat_handle == 'inicio' or block.settings.url == '/' or block.settings.url == routes.root_url -%}
            {%- assign is_block_active = true -%}
          {%- endif -%}
        {%- elsif request.page_type == 'collection' -%}
          {%- if current_handle != blank and current_handle == cat_handle -%}
            {%- assign is_block_active = true -%}
          {%- endif -%}
        {%- endif -%}

        <a href="{{ block_collection.url | default: block.settings.url | default: '#' }}" class="ll-sidebar__nav-item{% if is_block_active %} is-active{% endif %}" {{ block.shopify_attributes }}>
          <span class="ll-sidebar__icon">
            {%- if block.settings.icon_image != blank -%}
              <img src="{{ block.settings.icon_image | image_url: width: 40 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="20" height="20" style="width:20px;height:20px;object-fit:contain;">
            {%- else -%}
              {%- render 'llamarada-icon-helper', icon: active_icon, size: 20 -%}
            {%- endif -%}
          </span>
          <span>{{ block.settings.title | default: block_collection.title | default: 'Categoría' }}</span>
        </a>
      {%- endfor -%}
    {%- else -%}
      <!-- Default fallback category links with dynamic icons -->
      <a href="{{ routes.root_url }}" class="ll-sidebar__nav-item{% if request.page_type == 'index' %} is-active{% endif %}">
        <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'inicio', size: 20 -%}</span>
        <span>Inicio</span>
      </a>
      <a href="/collections/hogar" class="ll-sidebar__nav-item{% if request.page_type == 'collection' and current_handle == 'hogar' %} is-active{% endif %}">
        <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'hogar', size: 20 -%}</span>
        <span>Hogar</span>
      </a>
      <a href="/collections/juguetes" class="ll-sidebar__nav-item{% if request.page_type == 'collection' and current_handle == 'juguetes' %} is-active{% endif %}">
        <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'juguetes', size: 20 -%}</span>
        <span>Juguetes</span>
      </a>
      <a href="/collections/cocina" class="ll-sidebar__nav-item{% if request.page_type == 'collection' and current_handle == 'cocina' %} is-active{% endif %}">
        <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'cocina', size: 20 -%}</span>
        <span>Cocina</span>
      </a>
      <a href="/collections/articulos-de-limpieza" class="ll-sidebar__nav-item{% if request.page_type == 'collection' and current_handle contains 'limpieza' %} is-active{% endif %}">
        <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'limpieza', size: 20 -%}</span>
        <span>Artículos de Limpieza</span>
      </a>
      <a href="/collections/bebes" class="ll-sidebar__nav-item{% if request.page_type == 'collection' and current_handle == 'bebes' %} is-active{% endif %}">
        <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'bebes', size: 20 -%}</span>
        <span>Bebés</span>
      </a>
      <a href="/collections/abarrotes" class="ll-sidebar__nav-item{% if request.page_type == 'collection' and current_handle == 'abarrotes' %} is-active{% endif %}">
        <span class="ll-sidebar__icon">{%- render 'llamarada-icon-helper', icon: 'abarrotes', size: 20 -%}</span>
        <span>Abarrotes</span>
      </a>
    {%- endif -%}
  </nav>

  <!-- Footer Links (Only Ayuda - Novedades removed as requested) -->
  <div class="ll-sidebar__footer-links">
    <a href="{{ section.settings.help_link | default: '/pages/contact' }}" class="ll-sidebar__footer-link{% if request.path == '/pages/contact' %} ll-footer__link--active{% endif %}">
      <span class="ll-sidebar__icon">
        {%- render 'llamarada-icon-helper', icon: 'ayuda', size: 18 -%}
      </span>
      <span>{{ section.settings.help_text | default: 'Ayuda' }}</span>
    </a>
  </div>
</aside>

{% schema %}
{
  "name": "Barra Lateral (Sidebar)",
  "class": "section-llamarada-sidebar",
  "settings": [
    {
      "type": "text",
      "id": "card_title",
      "label": "Título de tarjeta superior",
      "default": "Importamos lo que necesitas"
    },
    {
      "type": "text",
      "id": "card_subtitle",
      "label": "Subtítulo de tarjeta superior",
      "default": "Venta por Mayoreo"
    },
    {
      "type": "text",
      "id": "login_btn_text",
      "label": "Texto del botón de iniciar sesión",
      "default": "Iniciar Sesión"
    },
    {
      "type": "url",
      "id": "login_link",
      "label": "Enlace del botón de iniciar sesión (vacío para URL por defecto)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de categorías de la tienda"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Texto enlace Ayuda",
      "default": "Ayuda"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Enlace Ayuda"
    }
  ],
  "blocks": [
    {
      "type": "category_item",
      "name": "Categoría de Menú",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección asociada"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título visual personalizado (opcional)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Enlace alternativo"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icono o imagen personalizada (subir desde computadora)"
        },
        {
          "type": "select",
          "id": "icon_preset",
          "label": "Icono de categoría",
          "options": [
            { "value": "auto", "label": "Automático (según nombre de colección)" },
            { "value": "inicio", "label": "Inicio" },
            { "value": "hogar", "label": "Hogar" },
            { "value": "decoracion", "label": "Decoración" },
            { "value": "juguetes", "label": "Juguetes" },
            { "value": "fiesta", "label": "Fiesta" },
            { "value": "belleza", "label": "Belleza" },
            { "value": "cocina", "label": "Cocina" },
            { "value": "limpieza", "label": "Limpieza" },
            { "value": "bebes", "label": "Bebés" },
            { "value": "abarrotes", "label": "Abarrotes" },
            { "value": "mascotas", "label": "Mascotas" },
            { "value": "ropa", "label": "Ropa / Moda" },
            { "value": "electronica", "label": "Electrónica" },
            { "value": "papeleria", "label": "Papelería" },
            { "value": "ferreteria", "label": "Ferretería" }
          ],
          "default": "auto"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Marcar como activa por defecto",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra Lateral (Sidebar)",
      "blocks": [
        { "type": "category_item", "settings": { "title": "Hogar", "icon_preset": "hogar" } },
        { "type": "category_item", "settings": { "title": "Juguetes", "icon_preset": "juguetes" } },
        { "type": "category_item", "settings": { "title": "Cocina", "icon_preset": "cocina" } },
        { "type": "category_item", "settings": { "title": "Artículos de Limpieza", "icon_preset": "limpieza" } },
        { "type": "category_item", "settings": { "title": "Bebés", "icon_preset": "bebes" } },
        { "type": "category_item", "settings": { "title": "Abarrotes", "icon_preset": "abarrotes" } }
      ]
    }
  ]
}
{% endschema %}
