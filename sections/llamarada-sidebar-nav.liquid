            {%- elsif block_collection.image != blank -%}
              <img src="{{ block_collection.image | image_url: width: 40 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="20" height="20" style="width:20px;height:20px;object-fit:cover;border-radius:4px;">
