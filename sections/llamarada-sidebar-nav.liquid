    {%- elsif section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign block_collection = block.settings.collection -%}
        {%- assign cat_handle = block_collection.handle | default: block.settings.title | handleize -%}
        {%- assign active_icon = block.settings.icon_preset -%}
        {%- if active_icon == blank or active_icon == 'auto' -%}
          {%- assign active_icon = cat_handle -%}
        {%- endif -%}
        {%- assign is_block_active = false -%}
        
        {%- if request.page_type == 'index' -%}
          {%- if cat_handle == 'inicio' or block.settings.url == '/' or block.settings.url == routes.root_url -%}
            {%- assign is_block_active = true -%}
          {%- endif -%}
        {%- elsif request.page_type == 'collection' -%}
          {%- if current_handle != blank and current_handle == cat_handle -%}
            {%- assign is_block_active = true -%}
          {%- endif -%}
        {%- endif -%}

        <a href="{{ block_collection.url | default: block.settings.url | default: '#' }}" class="ll-sidebar__nav-item{% if is_block_active %} is-active{% endif %}" {{ block.shopify_attributes }}>
