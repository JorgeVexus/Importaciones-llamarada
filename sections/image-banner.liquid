<div class="ll-home">
  <!-- Reusable Sidebar -->
  {% render 'llamarada-sidebar', active_handle: blank %}

  <!-- Main Canvas Content -->
  <main class="ll-canvas">
    <!-- Hero Banner -->
    <section class="ll-hero" aria-label="Banner principal">
      <div class="ll-hero__glow-1" aria-hidden="true"></div>
      <div class="ll-hero__glow-2" aria-hidden="true"></div>
      
      <div class="ll-hero__content">
        <h1 class="ll-hero__title">
          {{ section.settings.heading | default: 'Importamos lo que necesitas' }}
        </h1>
        <p class="ll-hero__subtitle">
          Abastece tu negocio con los mejores precios de mayoreo directamente desde fábrica.
        </p>
        <a href="/collections/all" class="ll-hero__cta">
          Ver Catálogo Mayorista
        </a>
      </div>
    </section>

    <!-- Popular Categories -->
    <section class="ll-categories" aria-labelledby="ll-categories-title">
      <div class="ll-section-header">
        <div class="ll-section-title-wrap">
          <span class="ll-section-title-icon">
            <svg width="20" height="20" viewBox="0 0 19 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.5 9L9 0L14.5 9H3.5V9M14.5 20C13.25 20 12.1875 19.5625 11.3125 18.6875C10.4375 17.8125 10 16.75 10 15.5C10 14.25 10.4375 13.1875 11.3125 12.3125C12.1875 11.4375 13.25 11 14.5 11C15.75 11 16.8125 11.4375 17.6875 12.3125C18.5625 13.1875 19 14.25 19 15.5C19 16.75 18.5625 17.8125 17.6875 18.6875C16.8125 19.5625 15.75 20 14.5 20V20M0 19.5V11.5H8V19.5H0V19.5" fill="#9424A4"/>
            </svg>
          </span>
          <h2 id="ll-categories-title" class="ll-section-title">Categorías Populares</h2>
        </div>
      </div>

      <div class="ll-categories__grid">
        <!-- Hogar -->
        <a href="/collections/hogar" class="ll-category-card">
          <div class="ll-category-card__box ll-category-card__box--hogar">
            <svg width="32" height="32" viewBox="0 0 22 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 6H18V4H16V6V6M16 10H18V8H16V10V10M16 14H18V12H16V14V14M16 18V16H20V2H11V3.4L9 1.95V0H22V18H16V18M0 18V8L7 3L14 8V18H8V13H6V18H0V18M2 16H4V11H10V16H12V9L7 5.45L2 9V16V16" fill="#f9321f"/></svg>
          </div>
          <span class="ll-category-card__label">Hogar</span>
        </a>

        <!-- Juguetes -->
        <a href="/collections/juguetes" class="ll-category-card">
          <div class="ll-category-card__box ll-category-card__box--juguetes">
            <svg width="32" height="32" viewBox="0 0 22 19" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 15H17V13H15V15V15M15 9H17V7H15V9V9M5 9H7V7H5V9V9M5 15H7V13H5V15V15M10.05 0H11.95C11.95 0 11.95 3.02 14.1 3.52C16.25 4.02 17.65 1.87 17.65 1.87L19 3.22C19 3.22 16.85 4.62 17.35 6.77C17.85 8.92 20.87 8.92 20.87 8.92V10.82C20.87 10.82 17.85 10.82 17.35 12.97C16.85 15.12 19 16.52 19 16.52L17.65 17.87C17.65 17.87 16.25 15.72 14.1 16.22C11.95 16.72 11.95 19.74 11.95 19.74H10.05C10.05 19.74 10.05 16.72 7.9 16.22C5.75 15.72 4.35 17.87 4.35 17.87L3 16.52C3 16.52 5.15 15.12 4.65 12.97C4.15 10.82 1.13 10.82 1.13 10.82V8.92C1.13 8.92 4.15 8.92 4.65 6.77C5.15 4.62 3 3.22 3 3.22L4.35 1.87C4.35 1.87 5.75 4.02 7.9 3.52C10.05 3.02 10.05 0 10.05 0V0" fill="#9424a4"/></svg>
          </div>
          <span class="ll-category-card__label">Juguetes</span>
        </a>

        <!-- Fiesta -->
        <a href="/collections/fiesta" class="ll-category-card">
          <div class="ll-category-card__box ll-category-card__box--fiesta">
            <svg width="32" height="32" viewBox="0 0 22 21" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.3 20.5L12.7 9.1L8.9 5.3L-2.5 16.7L1.3 20.5ZM13.8 8L10 4.2L12.5 1.7C13.2 1 14.4 1 15.1 1.7L16.3 2.9C17 3.6 17 4.8 16.3 5.5L13.8 8ZM18 10L19.5 8.5L21 10L19.5 11.5L18 10ZM15 14L16.5 12.5L18 14L16.5 15.5L15 14ZM8 0L9.5 1.5L8 3L6.5 1.5L8 0ZM4 4L5.5 2.5L7 4L5.5 5.5L4 4Z" fill="#d97706"/></svg>
          </div>
          <span class="ll-category-card__label">Fiesta</span>
        </a>

        <!-- Belleza -->
        <a href="/collections/belleza" class="ll-category-card">
          <div class="ll-category-card__box ll-category-card__box--belleza">
            <svg width="32" height="32" viewBox="0 0 24 22" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C16.42 2 20 5.58 20 10C20 13.08 18.25 15.75 15.69 17.06L16.5 21H14.25L13.75 18.5H10.25L9.75 21H7.5L8.31 17.06C5.75 15.75 4 13.08 4 10C4 5.58 7.58 2 12 2ZM12 4C8.69 4 6 6.69 6 10C6 12.47 7.5 14.6 9.68 15.5L10.5 16.5H13.5L14.32 15.5C16.5 14.6 18 12.47 18 10C18 6.69 15.31 4 12 4Z" fill="#16a34a"/></svg>
          </div>
          <span class="ll-category-card__label">Belleza</span>
        </a>

        <!-- Cocina -->
        <a href="/collections/cocina" class="ll-category-card">
          <div class="ll-category-card__box ll-category-card__box--cocina">
            <svg width="32" height="32" viewBox="0 0 20 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M18 6H2V4H18V6ZM16 16H4V8H16V16ZM19 2H1V0H19V2ZM10 10H6V14H10V10Z" fill="#dc2626"/></svg>
          </div>
          <span class="ll-category-card__label">Cocina</span>
        </a>

        <!-- Abarrotes -->
        <a href="/collections/abarrotes" class="ll-category-card">
          <div class="ll-category-card__box ll-category-card__box--abarrotes">
            <svg width="32" height="32" viewBox="0 0 22 19" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 6H16.71L12.55 0.17L10.92 1.33L14.26 6H7.74L11.08 1.33L9.45 0.17L5.29 6H3C1.34 6 0 7.34 0 9V17C0 18.66 1.34 20 3 20H19C20.66 20 22 18.66 22 17V9C22 7.34 20.66 6 19 6ZM19 18H3C2.45 18 2 17.55 2 17V9C2 8.45 2.45 8 3 8H19C19.55 8 20 8.45 20 9V17C20 17.55 19.55 18 19 18Z" fill="#9333ea"/></svg>
          </div>
          <span class="ll-category-card__label">Abarrotes</span>
        </a>
      </div>
    </section>

    <!-- Wholesale Featured Deals -->
    <section class="ll-featured-deals" aria-labelledby="ll-deals-title">
      <div class="ll-section-header">
        <div>
          <div class="ll-section-title-wrap">
            <span class="ll-section-title-icon">
              <svg width="20" height="20" viewBox="0 0 16 19" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 0C8 0 10.5 3 10.5 5.5C10.5 7.5 9 8.5 8 9.5C7 8.5 5.5 7.5 5.5 5.5C5.5 3 8 0 8 0ZM13.5 6.5C13.5 6.5 16 9.5 16 12C16 15.5 12.5 18.5 8 18.5C3.5 18.5 0 15.5 0 12C0 8.5 4.5 4.5 4.5 4.5C4.5 4.5 3 7.5 3 9.5C3 11.5 5 12.5 6 12.5C7 12.5 7.5 11.5 7.5 10.5C7.5 8.5 5.5 7.5 5.5 7.5C5.5 7.5 13.5 6.5 13.5 6.5Z" fill="#f9321f"/></svg>
            </span>
            <h2 id="ll-deals-title" class="ll-section-title">Ofertas de Mayoreo</h2>
          </div>
          <p class="ll-section-subtitle">Precios especiales por caja cerrada</p>
        </div>

        <a href="/collections/all" class="ll-section-link">
          <span>Ver todas</span>
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 5H9M9 5L5 1M9 5L5 9" stroke="#F9321F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

      <div class="ll-products-grid">
        <!-- Product 1 -->
        <article class="ll-product-card">
          <div class="ll-product-card__badges">
            <span class="ll-badge ll-badge--yellow">MAYOREO</span>
            <span class="ll-badge ll-badge--red">-25%</span>
          </div>

          <div class="ll-product-card__media">
            <img src="{{ 'prod-candles.png' | asset_url }}" alt="Caja 24 Velas Aromáticas Surtidas" loading="lazy" width="300" height="192">
          </div>

          <div class="ll-product-card__body">
            <div>
              <div class="ll-product-card__meta">
                <span class="ll-product-card__category">Hogar / Decoración</span>
                <div class="ll-product-card__rating">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 0L7.8 3.6L11.7 4.2L8.9 6.9L9.5 10.8L6 9L2.5 10.8L3.1 6.9L0.3 4.2L4.2 3.6L6 0Z" fill="#FEC017"/></svg>
                  <span>4.8</span>
                </div>
              </div>

              <h3 class="ll-product-card__title">Caja 24 Velas Aromáticas Surtidas…</h3>
            </div>

            <div class="ll-product-card__footer">
              <div>
                <p class="ll-product-card__price">$480.00</p>
                <p class="ll-product-card__unit-info">Caja con 24 pzas ($20.00 c/u)</p>
              </div>

              <a href="/products/caja-velas" class="ll-product-card__btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z" fill="#9424A4"/></svg>
                <span>Agregar Caja</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Product 2 -->
        <article class="ll-product-card">
          <div class="ll-product-card__badges">
            <span class="ll-badge ll-badge--yellow">MAYOREO</span>
          </div>

          <div class="ll-product-card__media">
            <img src="{{ 'prod-cups.png' | asset_url }}" alt="Lote 12 Vasos Vidrio Kawaii con Perlas" loading="lazy" width="300" height="192">
          </div>

          <div class="ll-product-card__body">
            <div>
              <div class="ll-product-card__meta">
                <span class="ll-product-card__category">Cocina / Termos</span>
                <div class="ll-product-card__rating">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 0L7.8 3.6L11.7 4.2L8.9 6.9L9.5 10.8L6 9L2.5 10.8L3.1 6.9L0.3 4.2L4.2 3.6L6 0Z" fill="#FEC017"/></svg>
                  <span>4.9</span>
                </div>
              </div>

              <h3 class="ll-product-card__title">Lote 12 Vasos Vidrio Kawaii con Perlas y…</h3>
            </div>

            <div class="ll-product-card__footer">
              <div>
                <p class="ll-product-card__price">$840.00</p>
                <p class="ll-product-card__unit-info">Lote con 12 pzas ($70.00 c/u)</p>
              </div>

              <a href="/products/lote-vasos" class="ll-product-card__btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z" fill="#9424A4"/></svg>
                <span>Agregar Lote</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Product 3 -->
        <article class="ll-product-card">
          <div class="ll-product-card__badges">
            <span class="ll-badge ll-badge--yellow">MAYOREO</span>
          </div>

          <div class="ll-product-card__media">
            <img src="{{ 'prod-brushes.png' | asset_url }}" alt="Caja 50 Sets Brochas Profesionales 12 pzas" loading="lazy" width="300" height="192">
          </div>

          <div class="ll-product-card__body">
            <div>
              <div class="ll-product-card__meta">
                <span class="ll-product-card__category">Belleza</span>
              </div>

              <h3 class="ll-product-card__title">Caja 50 Sets Brochas Profesionales 12 pzas</h3>
            </div>

            <div class="ll-product-card__footer">
              <div>
                <p class="ll-product-card__price">$3,250.00</p>
                <p class="ll-product-card__unit-info">Caja con 50 sets ($65.00 c/u)</p>
              </div>

              <a href="/products/caja-brochas" class="ll-product-card__btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z" fill="#9424A4"/></svg>
                <span>Agregar Caja</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Product 4 -->
        <article class="ll-product-card">
          <div class="ll-product-card__badges">
            <span class="ll-badge ll-badge--green">NUEVO</span>
          </div>

          <div class="ll-product-card__media">
            <img src="{{ 'prod-bibs.png' | asset_url }}" alt="Lote 30 Baberos Silicón Ajustables Tonos Pastel" loading="lazy" width="300" height="192">
          </div>

          <div class="ll-product-card__body">
            <div>
              <div class="ll-product-card__meta">
                <span class="ll-product-card__category">Bebés</span>
              </div>

              <h3 class="ll-product-card__title">Lote 30 Baberos Silicón Ajustables Tonos Pastel</h3>
            </div>

            <div class="ll-product-card__footer">
              <div>
                <p class="ll-product-card__price">$1,050.00</p>
                <p class="ll-product-card__unit-info">Lote con 30 pzas ($35.00 c/u)</p>
              </div>

              <a href="/products/lote-baberos" class="ll-product-card__btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z" fill="#9424A4"/></svg>
                <span>Agregar Lote</span>
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>
  </main>
</div>

{% schema %}
{
  "name": "Image Banner",
  "class": "section-image-banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Importamos lo que necesitas"
    }
  ]
}
{% endschema %}
