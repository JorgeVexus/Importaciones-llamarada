{% comment %}
  Featured Products - Modern Grid
  Sección de productos destacados con diseño moderno tipo grid
  @author: Jorge Cerna - Vexus
{% endcomment %}

{%- liquid
  assign products_count = section.settings.products.count
  if products_count == 0
    assign products_count = section.settings.number_of_products
  endif

  case section.settings.columns_desktop
    when 2
      assign grid_class = 'grid-2'
    when 3
      assign grid_class = 'grid-3'
    when 4
      assign grid_class = 'grid-4'
    when 5
      assign grid_class = 'grid-5'
    else
      assign grid_class = 'grid-4'
  endcase

  assign show_header = false
  if section.settings.title != blank or section.settings.show_view_all
    assign show_header = true
  endif
-%}

<section
  id="shopify-section-{{ section.id }}"
  class="featured-products-modern section-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="section-container">
    {%- if show_header -%}
      <div class="section-header">
        {%- if section.settings.title != blank -%}
          <h2 class="section-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        
        {%- if section.settings.show_view_all and section.settings.view_all_link != blank -%}
          <a href="{{ section.settings.view_all_link }}" class="btn-view-all">
            {{ section.settings.view_all_text }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="products-grid {{ grid_class }}">
      {%- if section.settings.products.count > 0 -%}
        {%- for product in section.settings.products -%}
          {%- render 'product-card-modern',
            product: product,
            index: forloop.index0,
            section: section,
            show_rating: section.settings.show_rating,
            show_swatches: section.settings.show_swatches,
            show_badges: section.settings.show_badges,
            show_price: section.settings.show_price
          -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.number_of_products) -%}
          {%- render 'product-card-modern',
            product: blank,
            index: forloop.index0,
            section: section,
            show_rating: section.settings.show_rating,
            show_swatches: section.settings.show_swatches,
            show_badges: section.settings.show_badges,
            show_price: section.settings.show_price,
            placeholder_int: i
          -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .featured-products-modern {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-bg: {{ section.settings.background_color }};
    --card-bg: {{ section.settings.card_background_color }};
    --card-border-radius: {{ section.settings.card_border_radius }}px;
    --image-bg: {{ section.settings.image_background_color }};
    --image-ratio: {{ section.settings.image_ratio | append: '%' }};
    --title-color: {{ section.settings.title_color }};
    --price-color: {{ section.settings.price_color }};
    --rating-color: {{ section.settings.rating_color }};
    --grid-gap: {{ section.settings.grid_gap }}px;
    
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    background-color: var(--section-bg);
  }

  .featured-products-modern .section-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  /* Header */
  .featured-products-modern .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    gap: 20px;
  }

  .featured-products-modern .section-title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    color: var(--title-color);
    margin: 0;
    text-transform: {{ section.settings.title_text_transform }};
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
  }

  .featured-products-modern .btn-view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-decoration: none;
    text-transform: {{ section.settings.button_text_transform }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    border-radius: {{ section.settings.button_border_radius }}px;
    transition: all 0.3s ease;
  }

  .featured-products-modern .btn-view-all:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  /* Grid */
  .featured-products-modern .products-grid {
    display: grid;
    gap: var(--grid-gap);
  }

  .featured-products-modern .grid-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .featured-products-modern .grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .featured-products-modern .grid-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .featured-products-modern .grid-5 {
    grid-template-columns: repeat(5, 1fr);
  }

  /* Product Card */
  .product-card-modern {
    background: var(--card-bg);
    border-radius: var(--card-border-radius);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .product-card-modern:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.1);
  }

  /* Image Container */
  .product-card-modern .card-image-wrapper {
    position: relative;
    background: var(--image-bg);
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .product-card-modern .card-image-wrapper a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card-modern .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 20px;
    transition: transform 0.5s ease;
  }

  .product-card-modern:hover .card-image-wrapper img {
    transform: scale(1.05);
  }

  /* Badge */
  .product-card-modern .product-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 6px 12px;
    background: {{ section.settings.badge_background }};
    color: {{ section.settings.badge_text_color }};
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 4px;
    z-index: 2;
  }

  .product-card-modern .product-badge.athlete-pick {
    background: {{ section.settings.badge_athlete_background }};
  }

  /* Swatches */
  .product-card-modern .card-swatches {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }

  .product-card-modern .swatch-item {
    width: 32px;
    height: 32px;
    border-radius: 4px;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .product-card-modern .swatch-item:hover,
  .product-card-modern .swatch-item.active {
    border-color: {{ section.settings.swatch_border_color }};
  }

  .product-card-modern .swatch-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Content */
  .product-card-modern .card-content {
    padding: 16px;
  }

  .product-card-modern .product-title {
    font-size: {{ section.settings.product_title_size }}px;
    font-weight: {{ section.settings.product_title_weight }};
    color: var(--title-color);
    margin: 0 0 8px 0;
    line-height: 1.3;
    text-transform: {{ section.settings.product_title_transform }};
  }

  .product-card-modern .product-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .product-card-modern .product-title a:hover {
    color: {{ section.settings.accent_color }};
  }

  /* Rating */
  .product-card-modern .product-rating {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }

  .product-card-modern .rating-stars {
    display: flex;
    gap: 2px;
  }

  .product-card-modern .rating-stars svg {
    width: 14px;
    height: 14px;
    fill: var(--rating-color);
  }

  .product-card-modern .rating-stars svg.empty {
    fill: #e5e7eb;
  }

  .product-card-modern .rating-count {
    font-size: 12px;
    color: {{ section.settings.text_muted_color }};
  }

  /* Price */
  .product-card-modern .product-price {
    font-size: {{ section.settings.price_font_size }}px;
    font-weight: {{ section.settings.price_font_weight }};
    color: var(--price-color);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .product-card-modern .price-original {
    text-decoration: line-through;
    color: {{ section.settings.price_original_color }};
    font-size: 0.85em;
  }

  /* Placeholder */
  .product-card-modern.placeholder .placeholder-svg {
    width: 100%;
    height: 100%;
    background: #f3f4f6;
  }

  /* Responsive */
  @media screen and (max-width: 1024px) {
    .featured-products-modern .grid-5 {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .featured-products-modern .section-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .featured-products-modern .section-title {
      font-size: {{ section.settings.title_font_size | times: 0.8 }}px;
    }

    .featured-products-modern .grid-4,
    .featured-products-modern .grid-5 {
      grid-template-columns: repeat(2, 1fr);
    }

    .featured-products-modern .grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 480px) {
    .featured-products-modern .products-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr) !important;
    }
  }
</style>

{% schema %}
{
  "name": "Productos Destacados",
  "tag": "section",
  "class": "section-featured-products-modern",
  "settings": [
    {
      "type": "header",
      "content": "t:global.section_header.content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título / Title",
      "default": "PRODUCTOS DESTACADOS"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar botón Ver Todo / Show View All Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Texto del botón / Button Text",
      "default": "VER TODO"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Enlace del botón / Button Link"
    },
    {
      "type": "header",
      "content": "Productos / Products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Productos / Products",
      "limit": 12
    },
    {
      "type": "range",
      "id": "number_of_products",
      "label": "Número de productos (placeholder) / Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Diseño / Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columnas en desktop / Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columnas en móvil / Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 columna"
        },
        {
          "value": "2",
          "label": "2 columnas"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Espacio entre tarjetas / Grid gap",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo del contenedor / Max container width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Tarjeta de producto / Product Card"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Mostrar calificación / Show rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Mostrar swatches de color / Show color swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Mostrar badges / Show badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Mostrar precio / Show price",
      "default": true
    },
    {
      "type": "range",
      "id": "image_ratio",
      "label": "Ratio de imagen / Image ratio",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "100% = Cuadrado / Square"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Radio del borde de tarjeta / Card border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colores / Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo de sección / Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Fondo de tarjeta / Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "image_background_color",
      "label": "Fondo de imagen / Image background",
      "default": "#f3f4f6"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color de título / Title color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Color de precio / Price color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "price_original_color",
      "label": "Color de precio original / Original price color",
      "default": "#9ca3af"
    },
    {
      "type": "color",
      "id": "rating_color",
      "label": "Color de estrellas / Rating color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento / Accent color",
      "default": "#6366f1"
    },
    {
      "type": "color",
      "id": "text_muted_color",
      "label": "Color de texto secundario / Muted text color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Color de divisor / Divider color",
      "default": "#e5e7eb"
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Fondo de badge / Badge background",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Texto de badge / Badge text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_athlete_background",
      "label": "Fondo badge Athlete / Athlete badge background",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "swatch_border_color",
      "label": "Borde de swatch / Swatch border color",
      "default": "#111827"
    },
    {
      "type": "header",
      "content": "Botón / Button"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Fondo del botón / Button background",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Texto del botón / Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Tamaño de fuente del botón / Button font size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_font_weight",
      "label": "Peso de fuente del botón / Button font weight",
      "min": 400,
      "max": 700,
      "step": 100,
      "default": 600
    },
    {
      "type": "select",
      "id": "button_text_transform",
      "label": "Transformación de texto / Text transform",
      "options": [
        {
          "value": "none",
          "label": "Normal"
        },
        {
          "value": "uppercase",
          "label": "Mayúsculas / Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalizar / Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "button_letter_spacing",
      "label": "Espaciado de letras / Letter spacing",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Radio del borde / Border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Tipografía / Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Tamaño de título / Title font size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "label": "Peso de título / Title font weight",
      "min": 400,
      "max": 900,
      "step": 100,
      "default": 900
    },
    {
      "type": "select",
      "id": "title_text_transform",
      "label": "Transformación de título / Title transform",
      "options": [
        {
          "value": "none",
          "label": "Normal"
        },
        {
          "value": "uppercase",
          "label": "Mayúsculas / Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalizar / Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "Espaciado de título / Title letter spacing",
      "min": -2,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Tamaño de nombre de producto / Product name size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "product_title_weight",
      "label": "Peso de nombre de producto / Product name weight",
      "min": 400,
      "max": 700,
      "step": 100,
      "default": 700
    },
    {
      "type": "select",
      "id": "product_title_transform",
      "label": "Transformación de nombre / Product name transform",
      "options": [
        {
          "value": "none",
          "label": "Normal"
        },
        {
          "value": "uppercase",
          "label": "Mayúsculas / Uppercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Tamaño de precio / Price font size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "price_font_weight",
      "label": "Peso de precio / Price font weight",
      "min": 400,
      "max": 700,
      "step": 100,
      "default": 400
    },
    {
      "type": "header",
      "content": "Espaciado / Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior / Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior / Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Productos Destacados Moderno / Featured Products Modern",
      "category": "Products / Productos"
    }
  ]
}
{% endschema %}
