<section class="ll-categories" aria-labelledby="ll-categories-title-{{ section.id }}">
  <div class="ll-section-header">
    <div class="ll-section-title-wrap">
      <span class="ll-section-title-icon">
        <svg width="20" height="20" viewBox="0 0 19 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3.5 9L9 0L14.5 9H3.5V9M14.5 20C13.25 20 12.1875 19.5625 11.3125 18.6875C10.4375 17.8125 10 16.75 10 15.5C10 14.25 10.4375 13.1875 11.3125 12.3125C12.1875 11.4375 13.25 11 14.5 11C15.75 11 16.8125 11.4375 17.6875 12.3125C18.5625 13.1875 19 14.25 19 15.5C19 16.75 18.5625 17.8125 17.6875 18.6875C16.8125 19.5625 15.75 20 14.5 20V20M0 19.5V11.5H8V19.5H0V19.5" fill="#9424A4"/>
        </svg>
      </span>
      <h2 id="ll-categories-title-{{ section.id }}" class="ll-section-title">
        {{ section.settings.title | default: 'Categorías Populares' }}
      </h2>
    </div>
  </div>

  <div class="ll-categories__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign cat_collection = block.settings.collection -%}
        {%- assign cat_title = cat_collection.title -%}
        {%- if cat_title == blank or block.settings.title != blank and block.settings.title != 'Categoría' -%}
          {%- if block.settings.title != blank -%}
            {%- assign cat_title = block.settings.title -%}
          {%- else -%}
            {%- assign cat_title = cat_collection.title | default: 'Categoría' -%}
          {%- endif -%}
        {%- endif -%}
        {%- assign cat_url = cat_collection.url | default: block.settings.url | default: '#' -%}
        {%- assign cat_handle = cat_collection.handle | default: cat_title | handleize -%}
        {%- assign active_icon = block.settings.icon_preset -%}
        {%- if active_icon == blank or active_icon == 'auto' -%}
          {%- assign active_icon = cat_handle -%}
        {%- endif -%}
        
        <a href="{{ cat_url }}" class="ll-category-card" {{ block.shopify_attributes }}>
          <div class="ll-category-card__box" style="background-color: {{ block.settings.bg_color | default: '#fee8e5' }};">
            {%- if block.settings.icon_image != blank -%}
              <img src="{{ block.settings.icon_image | image_url: width: 80 }}" alt="{{ cat_title | escape }}" loading="lazy" width="36" height="36" style="width:36px;height:36px;object-fit:contain;">
            {%- elsif cat_collection.image != blank -%}
              <img src="{{ cat_collection.image | image_url: width: 80 }}" alt="{{ cat_title | escape }}" loading="lazy" width="36" height="36" style="width:36px;height:36px;object-fit:cover;border-radius:6px;">
            {%- elsif cat_collection.featured_image != blank -%}
              <img src="{{ cat_collection.featured_image | image_url: width: 80 }}" alt="{{ cat_title | escape }}" loading="lazy" width="36" height="36" style="width:36px;height:36px;object-fit:cover;border-radius:6px;">
            {%- else -%}
              {%- case active_icon -%}
                {%- when 'hogar' -%}
                  <svg width="32" height="32" viewBox="0 0 22 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 6H18V4H16V6V6M16 10H18V8H16V10V10M16 14H18V12H16V14V14M16 18V16H20V2H11V3.4L9 1.95V0H22V18H16V18M0 18V8L7 3L14 8V18H8V13H6V18H0V18M2 16H4V11H10V16H12V9L7 5.45L2 9V16V16" fill="#f9321f"/></svg>
                {%- when 'decoracion', 'decor' -%}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.5-6.2 4.5 2.4-7.4-6.2-4.5h7.6z" fill="#f59e0b"/></svg>
                {%- when 'juguetes', 'ninos' -%}
                  <svg width="32" height="32" viewBox="0 0 22 19" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 15H17V13H15V15V15M15 9H17V7H15V9V9M5 9H7V7H5V9V9M5 15H7V13H5V15V15M10.05 0H11.95C11.95 0 11.95 3.02 14.1 3.52C16.25 4.02 17.65 1.87 17.65 1.87L19 3.22C19 3.22 16.85 4.62 17.35 6.77C17.85 8.92 20.87 8.92 20.87 8.92V10.82C20.87 10.82 17.85 10.82 17.35 12.97C16.85 15.12 19 16.52 19 16.52L17.65 17.87C17.65 17.87 16.25 15.72 14.1 16.22C11.95 16.72 11.95 19.74 11.95 19.74H10.05C10.05 19.74 10.05 16.72 7.9 16.22C5.75 15.72 4.35 17.87 4.35 17.87L3 16.52C3 16.52 5.15 15.12 4.65 12.97C4.15 10.82 1.13 10.82 1.13 10.82V8.92C4.15 8.92 4.65 6.77C5.15 4.62 3 3.22 3 3.22L4.35 1.87C4.35 1.87 5.75 4.02 7.9 3.52C10.05 3.02 10.05 0 10.05 0V0" fill="#9424a4"/></svg>
                {%- when 'fiesta', 'eventos' -%}
                  <svg width="32" height="32" viewBox="0 0 22 21" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.3 20.5L12.7 9.1L8.9 5.3L-2.5 16.7L1.3 20.5ZM13.8 8L10 4.2L12.5 1.7C13.2 1 14.4 1 15.1 1.7L16.3 2.9C17 3.6 17 4.8 16.3 5.5L13.8 8ZM18 10L19.5 8.5L21 10L19.5 11.5L18 10ZM15 14L16.5 12.5L18 14L16.5 15.5L15 14ZM8 0L9.5 1.5L8 3L6.5 1.5L8 0ZM4 4L5.5 2.5L7 4L5.5 5.5L4 4Z" fill="#d97706"/></svg>
                {%- when 'belleza', 'cosmeticos', 'maquillaje' -%}
                  <svg width="32" height="32" viewBox="0 0 24 22" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C16.42 2 20 5.58 20 10C20 13.08 18.25 15.75 15.69 17.06L16.5 21H14.25L13.75 18.5H10.25L9.75 21H7.5L8.31 17.06C5.75 15.75 4 13.08 4 10C4 5.58 7.58 2 12 2ZM12 4C8.69 4 6 6.69 6 10C6 12.47 7.5 14.6 9.68 15.5L10.5 16.5H13.5L14.32 15.5C16.5 14.6 18 12.47 18 10C18 6.69 15.31 4 12 4Z" fill="#16a34a"/></svg>
                {%- when 'cocina', 'utensilios' -%}
                  <svg width="32" height="32" viewBox="0 0 20 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M18 6H2V4H18V6ZM16 16H4V8H16V16ZM19 2H1V0H19V2ZM10 10H6V14H10V10Z" fill="#dc2626"/></svg>
                {%- when 'limpieza', 'articulos-de-limpieza' -%}
                  <svg width="32" height="32" viewBox="0 0 18 22" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14 8V2H16V0H2V2H4V8L0 12V22H18V12L14 8ZM6 2H12V8H6V2ZM16 20H2V13H16V20Z" fill="#2563eb"/></svg>
                {%- when 'bebes', 'maternidad' -%}
                  <svg width="32" height="32" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 0C4.03 0 0 4.03 0 9C0 13.97 4.03 18 9 18C13.97 18 18 13.97 18 9C18 4.03 13.97 0 9 0ZM9 2C12.87 2 16 5.13 16 9C16 12.87 12.87 16 9 16C5.13 16 2 12.87 2 9C2 5.13 5.13 2 9 2ZM6 7C5.45 7 5 7.45 5 8C5 8.55 5.45 9 6 9C6.55 9 7 8.55 7 8C7 7.45 6.55 7 6 7ZM12 7C11.45 7 11 7.45 11 8C11 8.55 11.45 9 12 9C12.55 9 13 8.55 13 8C13 7.45 12.55 7 12 7ZM9 11C7.33 11 5.92 12.08 5.38 13.6C5.22 14.05 5.56 14.5 6.04 14.5H11.96C12.44 14.5 12.78 14.05 12.62 13.6C12.08 12.08 10.67 11 9 11Z" fill="#0284c7"/></svg>
                {%- when 'abarrotes', 'despensa' -%}
                  <svg width="32" height="32" viewBox="0 0 22 19" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 6H16.71L12.55 0.17L10.92 1.33L14.26 6H7.74L11.08 1.33L9.45 0.17L5.29 6H3C1.34 6 0 7.34 0 9V17C0 18.66 1.34 20 3 20H19C20.66 20 22 18.66 22 17V9C22 7.34 20.66 6 19 6ZM19 18H3C2.45 18 2 17.55 2 17V9C2 8.45 2.45 8 3 8H19C19.55 8 20 8.45 20 9V17C20 17.55 19.55 18 19 18Z" fill="#9333ea"/></svg>
                {%- when 'mascotas', 'pet' -%}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="4.5" cy="9.5" r="2.5" fill="#ec4899"/><circle cx="9" cy="5.5" r="2.5" fill="#ec4899"/><circle cx="15" cy="5.5" r="2.5" fill="#ec4899"/><circle cx="19.5" cy="9.5" r="2.5" fill="#ec4899"/><path d="M17.34 14.86c-.87-1.02-1.6-1.89-2.48-2.49-.9-.62-2.02-.95-2.86-.95s-1.96.33-2.86.95c-.88.6-1.61 1.47-2.48 2.49-1.03 1.2-1.88 2.51-1.61 3.86.29 1.45 1.5 2.28 3.1 2.28 1.05 0 2.23-.42 3.85-.42 1.61 0 2.8.42 3.85.42 1.6 0 2.81-.83 3.1-2.28.26-1.35-.59-2.66-1.61-3.86z" fill="#ec4899"/></svg>
                {%- when 'ropa', 'moda', 'textil' -%}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 4a3 3 0 00-2.83 2H4l2 5h2v9h8v-9h2l2-5h-5.17A3 3 0 0012 4z" fill="#8b5cf6"/></svg>
                {%- when 'electronica', 'tecnologia', 'gadgets' -%}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 6h16v10H4V6zm2 12h12v2H6v-2zm1-9h10v6H7V9z" fill="#06b6d4"/></svg>
                {%- when 'papeleria', 'oficina', 'escolar' -%}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a.996.996 0 000-1.41l-2.34-2.34a.996.996 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" fill="#10b981"/></svg>
                {%- when 'ferreteria', 'herramientas' -%}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z" fill="#64748b"/></svg>
                {%- else -%}
                  <svg width="32" height="32" viewBox="0 0 22 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 6H18V4H16V6V6M16 10H18V8H16V10V10M16 14H18V12H16V14V14M16 18V16H20V2H11V3.4L9 1.95V0H22V18H16V18M0 18V8L7 3L14 8V18H8V13H6V18H0V18M2 16H4V11H10V16H12V9L7 5.45L2 9V16V16" fill="#9424a4"/></svg>
              {%- endcase -%}
            {%- endif -%}
          </div>
          <span class="ll-category-card__label">{{ cat_title }}</span>
        </a>
      {%- endfor -%}
    {%- else -%}
      <!-- Default fallback categories matching Figma -->
      <a href="/collections/hogar" class="ll-category-card">
        <div class="ll-category-card__box ll-category-card__box--hogar">
          <svg width="32" height="32" viewBox="0 0 22 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 6H18V4H16V6V6M16 10H18V8H16V10V10M16 14H18V12H16V14V14M16 18V16H20V2H11V3.4L9 1.95V0H22V18H16V18M0 18V8L7 3L14 8V18H8V13H6V18H0V18M2 16H4V11H10V16H12V9L7 5.45L2 9V16V16" fill="#f9321f"/></svg>
        </div>
        <span class="ll-category-card__label">Hogar</span>
      </a>

      <a href="/collections/juguetes" class="ll-category-card">
        <div class="ll-category-card__box ll-category-card__box--juguetes">
          <svg width="32" height="32" viewBox="0 0 22 19" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 15H17V13H15V15V15M15 9H17V7H15V9V9M5 9H7V7H5V9V9M5 15H7V13H5V15V15M10.05 0H11.95C11.95 0 11.95 3.02 14.1 3.52C16.25 4.02 17.65 1.87 17.65 1.87L19 3.22C19 3.22 16.85 4.62 17.35 6.77C17.85 8.92 20.87 8.92 20.87 8.92V10.82C20.87 10.82 17.85 10.82 17.35 12.97C16.85 15.12 19 16.52 19 16.52L17.65 17.87C17.65 17.87 16.25 15.72 14.1 16.22C11.95 16.72 11.95 19.74 11.95 19.74H10.05C10.05 19.74 10.05 16.72 7.9 16.22C5.75 15.72 4.35 17.87 4.35 17.87L3 16.52C3 16.52 5.15 15.12 4.65 12.97C4.15 10.82 1.13 10.82 1.13 10.82V8.92C4.15 8.92 4.65 6.77C5.15 4.62 3 3.22 3 3.22L4.35 1.87C4.35 1.87 5.75 4.02 7.9 3.52C10.05 3.02 10.05 0 10.05 0V0" fill="#9424a4"/></svg>
        </div>
        <span class="ll-category-card__label">Juguetes</span>
      </a>

      <a href="/collections/cocina" class="ll-category-card">
        <div class="ll-category-card__box ll-category-card__box--cocina">
          <svg width="32" height="32" viewBox="0 0 20 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M18 6H2V4H18V6ZM16 16H4V8H16V16ZM19 2H1V0H19V2ZM10 10H6V14H10V10Z" fill="#dc2626"/></svg>
        </div>
        <span class="ll-category-card__label">Cocina</span>
      </a>

      <a href="/collections/articulos-de-limpieza" class="ll-category-card">
        <div class="ll-category-card__box ll-category-card__box--limpieza">
          <svg width="32" height="32" viewBox="0 0 18 22" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14 8V2H16V0H2V2H4V8L0 12V22H18V12L14 8ZM6 2H12V8H6V2ZM16 20H2V13H16V20Z" fill="#2563eb"/></svg>
        </div>
        <span class="ll-category-card__label">Artículos de Limpieza</span>
      </a>

      <a href="/collections/bebes" class="ll-category-card">
        <div class="ll-category-card__box ll-category-card__box--bebes">
          <svg width="32" height="32" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 0C4.03 0 0 4.03 0 9C0 13.97 4.03 18 9 18C13.97 18 18 13.97 18 9C18 4.03 13.97 0 9 0ZM9 2C12.87 2 16 5.13 16 9C16 12.87 12.87 16 9 16C5.13 16 2 12.87 2 9C2 5.13 5.13 2 9 2ZM6 7C5.45 7 5 7.45 5 8C5 8.55 5.45 9 6 9C6.55 9 7 8.55 7 8C7 7.45 6.55 7 6 7ZM12 7C11.45 7 11 7.45 11 8C11 8.55 11.45 9 12 9C12.55 9 13 8.55 13 8C13 7.45 12.55 7 12 7ZM9 11C7.33 11 5.92 12.08 5.38 13.6C5.22 14.05 5.56 14.5 6.04 14.5H11.96C12.44 14.5 12.78 14.05 12.62 13.6C12.08 12.08 10.67 11 9 11Z" fill="#0284c7"/></svg>
        </div>
        <span class="ll-category-card__label">Bebés</span>
      </a>

      <a href="/collections/abarrotes" class="ll-category-card">
        <div class="ll-category-card__box ll-category-card__box--abarrotes">
          <svg width="32" height="32" viewBox="0 0 22 19" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 6H16.71L12.55 0.17L10.92 1.33L14.26 6H7.74L11.08 1.33L9.45 0.17L5.29 6H3C1.34 6 0 7.34 0 9V17C0 18.66 1.34 20 3 20H19C20.66 20 22 18.66 22 17V9C22 7.34 20.66 6 19 6ZM19 18H3C2.45 18 2 17.55 2 17V9C2 8.45 2.45 8 3 8H19C19.55 8 20 8.45 20 9V17C20 17.55 19.55 18 19 18Z" fill="#9333ea"/></svg>
        </div>
        <span class="ll-category-card__label">Abarrotes</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Categorías Populares",
  "class": "section-llamarada-categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título de la sección",
      "default": "Categorías Populares"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Tarjeta de Categoría",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección de Shopify"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título visual personalizado (opcional)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Enlace personalizado alternativo"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Color pastel de fondo",
          "default": "#fee8e5"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icono o imagen personalizada (subir desde computadora)"
        },
        {
          "type": "select",
          "id": "icon_preset",
          "label": "Icono vectorial prestablecido (si no se sube imagen)",
          "options": [
            { "value": "auto", "label": "Automático (según nombre de colección)" },
            { "value": "hogar", "label": "Hogar" },
            { "value": "decoracion", "label": "Decoración" },
            { "value": "juguetes", "label": "Juguetes" },
            { "value": "fiesta", "label": "Fiesta" },
            { "value": "belleza", "label": "Belleza" },
            { "value": "cocina", "label": "Cocina" },
            { "value": "limpieza", "label": "Limpieza" },
            { "value": "bebes", "label": "Bebés" },
            { "value": "abarrotes", "label": "Abarrotes" },
            { "value": "mascotas", "label": "Mascotas" },
            { "value": "ropa", "label": "Ropa / Moda" },
            { "value": "electronica", "label": "Electrónica" },
            { "value": "papeleria", "label": "Papelería" },
            { "value": "ferreteria", "label": "Ferretería" }
          ],
          "default": "auto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías Populares",
      "blocks": [
        { "type": "category_card", "settings": { "title": "Hogar", "bg_color": "#fee8e5", "icon_preset": "hogar" } },
        { "type": "category_card", "settings": { "title": "Juguetes", "bg_color": "#eed6f2", "icon_preset": "juguetes" } },
        { "type": "category_card", "settings": { "title": "Cocina", "bg_color": "#fde0dc", "icon_preset": "cocina" } },
        { "type": "category_card", "settings": { "title": "Artículos de Limpieza", "bg_color": "#e0f2fe", "icon_preset": "limpieza" } },
        { "type": "category_card", "settings": { "title": "Bebés", "bg_color": "#e0f7fa", "icon_preset": "bebes" } },
        { "type": "category_card", "settings": { "title": "Abarrotes", "bg_color": "#f3e5f5", "icon_preset": "abarrotes" } }
      ]
    }
  ]
}
{% endschema %}
