{%- assign has_image = false -%}
{%- if section.settings.image != blank -%}
  {%- assign has_image = true -%}
{%- endif -%}

<section
  class="ll-hero{% if has_image %} ll-hero--has-image{% endif %}"
  aria-label="Banner principal"
  style="{% if has_image == false %}background: linear-gradient(105deg, {{ section.settings.gradient_start | default: '#9424a4' }} 0%, {{ section.settings.gradient_end | default: '#f9321f' }} 100%);{% endif %}"
>
  {%- if has_image -%}
    <picture class="ll-hero__picture">
      {%- if section.settings.image_mobile != blank -%}
        <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}">
      {%- endif -%}
      <img
        src="{{ section.settings.image | image_url: width: 1600 }}"
        alt="{{ section.settings.image.alt | escape | default: section.settings.title }}"
        class="ll-hero__bg-img"
        loading="eager"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    </picture>
    {%- assign overlay_opacity_val = section.settings.overlay_opacity | default: 40 -%}
    {%- assign overlay_color = section.settings.overlay_color | default: '#000000' -%}
    {%- if overlay_color == blank -%}{%- assign overlay_color = '#000000' -%}{%- endif -%}
    <div
      class="ll-hero__overlay"
      style="background-color: {{ overlay_color }} !important; opacity: calc({{ overlay_opacity_val }} / 100) !important; z-index: 2 !important;"
    ></div>
  {%- else -%}
    <div class="ll-hero__glow-1" aria-hidden="true"></div>
    <div class="ll-hero__glow-2" aria-hidden="true"></div>
  {%- endif -%}
  
  <div class="ll-hero__content" style="z-index: 5 !important;">
    {%- if section.settings.title != blank -%}
      <h1 class="ll-hero__title" style="color: {{ section.settings.title_color | default: '#ffffff' }} !important;">
        {{ section.settings.title }}
      </h1>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="ll-hero__subtitle" style="color: {{ section.settings.subtitle_color | default: '#e8d0ed' }} !important;">
        {{ section.settings.subtitle }}
      </p>
    {%- endif -%}
    {%- if section.settings.cta_text != blank -%}
      <a
        href="{{ section.settings.cta_link | default: '/collections/all' }}"
        class="ll-hero__cta"
        style="background-color: {{ section.settings.cta_bg_color | default: '#91c441' }} !important; color: {{ section.settings.cta_text_color | default: '#1b1b1b' }} !important;"
      >
        {{ section.settings.cta_text }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Banner Hero Principal",
  "class": "section-llamarada-hero",
  "settings": [
    {
      "type": "header",
      "content": "Imagen de Fondo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen de fondo (Móvil - Opcional)"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color de oscurecimiento (Overlay)",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Oscurecimiento de imagen (Overlay)",
      "default": 40
    },
    {
      "type": "header",
      "content": "Contenido de Texto"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título principal",
      "default": "Importamos lo que necesitas"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#ffffff"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo explicativo",
      "default": "Abastece tu negocio con los mejores precios de mayoreo directamente desde fábrica."
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Color del subtítulo",
      "default": "#e8d0ed"
    },
    {
      "type": "header",
      "content": "Botón CTA"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texto del botón CTA",
      "default": "Ver Catálogo Mayorista"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del botón CTA"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "Color de fondo del botón CTA",
      "default": "#91c441"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Color de texto del botón CTA",
      "default": "#1b1b1b"
    },
    {
      "type": "header",
      "content": "Gradiente de Fondo (sin imagen)"
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Color inicio de gradiente",
      "default": "#9424a4"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Color fin de gradiente",
      "default": "#f9321f"
    }
  ],
  "presets": [
    {
      "name": "Banner Hero Principal"
    }
  ]
}
{% endschema %}
