{% comment %}
  Hero Certificación NIJ - Arsenal
  Sección Hero destacada de Certificación Balística NIJ 0101.07 con insignias y pilares de marca.
  @author: Jorge Cerna - Vexus
{% endcomment %}

{%- style -%}
  /* Control de Ancho Completo para Romper Contenedor del Tema */
  #shopify-section-{{ section.id }} {
    width: 100%;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  {% if section.settings.full_width %}
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }}.shopify-section {
      width: 100vw !important;
      max-width: 100vw !important;
      position: relative !important;
      left: 50% !important;
      right: 50% !important;
      margin-left: -50vw !important;
      margin-right: -50vw !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      box-sizing: border-box !important;
    }
  {% endif %}

  /* Contenedor y espaciado de sección */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Estilos Principales del Hero NIJ */
  .hero-nij-{{ section.id }} {
    position: relative;
    background: linear-gradient({{ section.settings.gradient_angle }}deg, {{ section.settings.bg_color_1 }} 0%, {{ section.settings.bg_color_2 }} 100%);
    color: {{ section.settings.text_color }};
    overflow: hidden;
    min-height: {{ section.settings.min_height_desktop }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Efectos dinámicos de fondo y destellos */
  .hero-nij-{{ section.id }} .hero-nij-glow-1 {
    position: absolute;
    top: -15%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, {{ section.settings.accent_color | color_modify: 'alpha', 0.35 }} 0%, rgba(0,0,0,0) 70%);
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
    z-index: 1;
    animation: heroPulse-{{ section.id }} 8s ease-in-out infinite alternate;
  }

  .hero-nij-{{ section.id }} .hero-nij-glow-2 {
    position: absolute;
    bottom: -20%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, {{ section.settings.secondary_accent | color_modify: 'alpha', 0.25 }} 0%, rgba(0,0,0,0) 70%);
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 1;
  }

  @keyframes heroPulse-{{ section.id }} {
    0% { transform: scale(1) translate(0, 0); opacity: 0.7; }
    100% { transform: scale(1.15) translate(-20px, 20px); opacity: 1; }
  }

  /* Grid Layout */
  .hero-nij-container-{{ section.id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 3;
    width: 100%;
  }

  .hero-nij-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .hero-nij-grid-{{ section.id }} {
      grid-template-columns: {% if section.settings.image_position == 'left' %}1.1fr 1fr{% else %}1fr 1.1fr{% endif %};
      gap: 60px;
    }
  }

  /* Orden visual según configuración */
  {% if section.settings.image_position == 'left' %}
    @media screen and (min-width: 990px) {
      .hero-nij-content-{{ section.id }} { order: 2; }
      .hero-nij-media-{{ section.id }} { order: 1; }
    }
  {% endif %}

  /* Columna de Contenido */
  .hero-nij-content-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Tagline Superior / Slogan */
  .hero-nij-tagline-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.4 }};
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 24px;
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 20px {{ section.settings.accent_color | color_modify: 'alpha', 0.15 }};
  }

  .hero-nij-tagline-{{ section.id }} .tagline-pulse {
    width: 8px;
    height: 8px;
    background-color: {{ section.settings.accent_color }};
    border-radius: 50%;
    box-shadow: 0 0 10px {{ section.settings.accent_color }};
    animation: pulseDot 1.5s infinite;
  }

  @keyframes pulseDot {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 {{ section.settings.accent_color | color_modify: 'alpha', 0.7 }}; }
    70% { transform: scale(1.1); box-shadow: 0 0 0 10px rgba(0, 0, 0, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 0, 0, 0); }
  }

  /* Encabezado y Titular */
  .hero-nij-cert-badge-{{ section.id }} {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.text_color | color_modify: 'alpha', 0.75 }};
    margin-bottom: 8px;
  }

  .hero-nij-title-{{ section.id }} {
    font-size: clamp(38px, 6vw, {{ section.settings.title_size_desktop }}px);
    line-height: 1.05;
    font-weight: 900;
    margin: 0 0 12px 0;
    text-transform: uppercase;
    letter-spacing: -1px;
    color: {{ section.settings.title_color }};
  }

  .hero-nij-title-{{ section.id }} .gradient-text {
    background: linear-gradient(135deg, {{ section.settings.accent_color }} 0%, #FFFFFF 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .hero-nij-subtitle-{{ section.id }} {
    font-size: clamp(18px, 2.5vw, 26px);
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 20px;
    position: relative;
    padding-bottom: 12px;
  }

  .hero-nij-subtitle-{{ section.id }}::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60px;
    height: 3px;
    background: {{ section.settings.accent_color }};
    border-radius: 2px;
    box-shadow: 0 0 12px {{ section.settings.accent_color }};
  }

  /* Caja Destacada Hito Mundial - Diseño Pill Glassmorphism Premium */
  .hero-nij-highlight-box-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 10px 22px 10px 14px;
    margin-top: 20px;
    margin-bottom: 24px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.3 }};
    border-radius: 50px;
    backdrop-filter: blur(16px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .hero-nij-highlight-box-{{ section.id }}:hover {
    border-color: {{ section.settings.accent_color | color_modify: 'alpha', 0.6 }};
    transform: translateY(-2px);
    box-shadow: 0 12px 35px {{ section.settings.accent_color | color_modify: 'alpha', 0.25 }};
  }

  .hero-nij-highlight-box-{{ section.id }} .highlight-icon {
    width: 34px;
    height: 34px;
    min-width: 34px;
    background: linear-gradient(135deg, {{ section.settings.accent_color }} 0%, {{ section.settings.secondary_accent }} 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    box-shadow: 0 4px 14px {{ section.settings.accent_color | color_modify: 'alpha', 0.5 }};
  }

  .hero-nij-highlight-box-{{ section.id }} .highlight-icon svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .hero-nij-highlight-box-{{ section.id }} span {
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.4;
    color: {{ section.settings.text_color }};
    letter-spacing: 0.2px;
  }

  .hero-nij-description-{{ section.id }} {
    font-size: 16px;
    line-height: 1.65;
    color: {{ section.settings.text_color | color_modify: 'alpha', 0.85 }};
    margin-bottom: 32px;
    max-width: 540px;
  }

  .hero-nij-description-{{ section.id }} strong {
    color: {{ section.settings.text_color }};
    font-weight: 700;
  }

  /* Botones de Acción */
  .hero-nij-actions-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 32px;
  }

  .hero-nij-btn-primary-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 36px;
    background: linear-gradient(135deg, {{ section.settings.accent_color }} 0%, {{ section.settings.secondary_accent }} 100%);
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: {{ section.settings.button_radius }}px;
    box-shadow: 0 8px 25px {{ section.settings.accent_color | color_modify: 'alpha', 0.4 }};
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    border: none;
    cursor: pointer;
  }

  .hero-nij-btn-primary-{{ section.id }}:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 35px {{ section.settings.accent_color | color_modify: 'alpha', 0.6 }};
    color: #FFFFFF;
  }

  .hero-nij-btn-secondary-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 32px;
    background: rgba(255, 255, 255, 0.05);
    color: {{ section.settings.text_color }};
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: {{ section.settings.button_radius }}px;
    border: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.3 }};
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
  }

  .hero-nij-btn-secondary-{{ section.id }}:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: {{ section.settings.accent_color }};
    color: {{ section.settings.accent_color }};
    transform: translateY(-2px);
  }

  /* Columna Visual / Imagen */
  .hero-nij-media-{{ section.id }} {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-nij-image-wrapper-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: 520px;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: visible;
  }

  .hero-nij-image-{{ section.id }} {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.6));
    transition: transform 0.5s ease;
  }

  .hero-nij-image-wrapper-{{ section.id }}:hover .hero-nij-image-{{ section.id }} {
    transform: scale(1.03);
  }

  /* Splash Líquido de Fondo en Imagen */
  .hero-nij-splash-overlay-{{ section.id }} {
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle, {{ section.settings.accent_color | color_modify: 'alpha', 0.2 }} 0%, transparent 70%);
    border-radius: 50%;
    z-index: -1;
    filter: blur(40px);
  }

  /* Insignia Flotante (Badge de Certificación) */
  .hero-nij-seal-badge-{{ section.id }} {
    position: absolute;
    bottom: -20px;
    left: -15px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 22px;
    background: {{ section.settings.badge_bg_color }};
    border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.5 }};
    border-radius: 16px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 20px {{ section.settings.accent_color | color_modify: 'alpha', 0.25 }};
    backdrop-filter: blur(16px);
    z-index: 4;
    max-width: 280px;
    animation: floatBadge-{{ section.id }} 4s ease-in-out infinite alternate;
  }

  @keyframes floatBadge-{{ section.id }} {
    0% { transform: translateY(0); }
    100% { transform: translateY(-8px); }
  }

  .hero-nij-seal-icon-{{ section.id }} {
    width: 48px;
    height: 48px;
    min-width: 48px;
    background: linear-gradient(135deg, {{ section.settings.accent_color }} 0%, {{ section.settings.secondary_accent }} 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    box-shadow: 0 6px 16px {{ section.settings.accent_color | color_modify: 'alpha', 0.4 }};
  }

  .hero-nij-seal-icon-{{ section.id }} svg {
    width: 26px;
    height: 26px;
    fill: currentColor;
  }

  .hero-nij-seal-text-{{ section.id }} {
    display: flex;
    flex-direction: column;
  }

  .hero-nij-seal-tag-{{ section.id }} {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
  }

  .hero-nij-seal-title-{{ section.id }} {
    font-size: 16px;
    font-weight: 900;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
    margin: 2px 0;
  }

  .hero-nij-seal-sub-{{ section.id }} {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    color: {{ section.settings.text_color | color_modify: 'alpha', 0.6 }};
    text-transform: uppercase;
  }

  /* Pilares de Características (Grid Inferior) */
  .hero-nij-pillars-container-{{ section.id }} {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.12 }};
  }

  .hero-nij-pillars-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media screen and (min-width: 990px) {
    .hero-nij-pillars-grid-{{ section.id }} {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  .hero-nij-pillar-card-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    background: {{ section.settings.pillar_bg_color }};
    border: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.08 }};
    border-radius: 14px;
    transition: all 0.3s ease;
    backdrop-filter: blur(8px);
  }

  .hero-nij-pillar-card-{{ section.id }}:hover {
    background: {{ section.settings.text_color | color_modify: 'alpha', 0.06 }};
    border-color: {{ section.settings.accent_color | color_modify: 'alpha', 0.4 }};
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  }

  .hero-nij-pillar-icon-{{ section.id }} {
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.3 }};
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.accent_color }};
    transition: all 0.3s ease;
  }

  .hero-nij-pillar-card-{{ section.id }}:hover .hero-nij-pillar-icon-{{ section.id }} {
    background: {{ section.settings.accent_color }};
    color: #FFFFFF;
    box-shadow: 0 4px 15px {{ section.settings.accent_color | color_modify: 'alpha', 0.5 }};
  }

  .hero-nij-pillar-icon-{{ section.id }} svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .hero-nij-pillar-info-{{ section.id }} {
    display: flex;
    flex-direction: column;
  }

  .hero-nij-pillar-title-{{ section.id }} {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    line-height: 1.3;
  }

  .hero-nij-pillar-desc-{{ section.id }} {
    font-size: 12px;
    color: {{ section.settings.text_color | color_modify: 'alpha', 0.6 }};
    margin-top: 3px;
    line-height: 1.3;
  }

  /* Ajustes Mobile */
  @media screen and (max-width: 749px) {
    .hero-nij-container-{{ section.id }} {
      padding-left: 18px !important;
      padding-right: 18px !important;
      box-sizing: border-box !important;
      width: 100% !important;
      max-width: 100% !important;
      overflow: hidden !important;
    }

    .hero-nij-content-{{ section.id }} {
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
      align-items: flex-start !important;
    }

    .hero-nij-tagline-{{ section.id }} {
      max-width: 100% !important;
      box-sizing: border-box !important;
      font-size: 11px !important;
      padding: 6px 14px !important;
      letter-spacing: 1px !important;
    }

    .hero-nij-highlight-box-{{ section.id }} {
      display: flex !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
      border-radius: 20px !important;
      padding: 10px 14px !important;
      margin-top: 14px !important;
      margin-bottom: 20px !important;
    }

    .hero-nij-highlight-box-{{ section.id }} span {
      font-size: 12.5px !important;
      line-height: 1.35 !important;
    }

    .hero-nij-description-{{ section.id }} {
      font-size: 14px !important;
      line-height: 1.5 !important;
      margin-bottom: 24px !important;
      max-width: 100% !important;
    }

    .hero-nij-actions-{{ section.id }} {
      width: 100% !important;
      flex-direction: column !important;
      gap: 12px !important;
      margin-bottom: 24px !important;
    }

    .hero-nij-btn-primary-{{ section.id }},
    .hero-nij-btn-secondary-{{ section.id }} {
      width: 100% !important;
      box-sizing: border-box !important;
      padding: 13px 20px !important;
      font-size: 13.5px !important;
      letter-spacing: 0.5px !important;
      border-radius: 50px !important;
      white-space: nowrap !important;
    }

    .hero-nij-btn-primary-{{ section.id }} svg,
    .hero-nij-btn-secondary-{{ section.id }} svg {
      width: 16px !important;
      height: 16px !important;
    }

    .hero-nij-seal-badge-{{ section.id }} {
      position: relative;
      bottom: 0;
      left: 0;
      margin-top: 20px;
      max-width: 100%;
      width: 100%;
    }

    .hero-nij-pillars-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div class="hero-nij-{{ section.id }} section-{{ section.id }}-padding">
  <!-- Destellos decorativos -->
  <div class="hero-nij-glow-1"></div>
  <div class="hero-nij-glow-2"></div>

  <div class="hero-nij-container-{{ section.id }}">
    <div class="hero-nij-grid-{{ section.id }}">
      
      <!-- Columna de Texto / Contenido -->
      <div class="hero-nij-content-{{ section.id }}">
        
        {%- if section.settings.top_tagline != blank -%}
          <div class="hero-nij-tagline-{{ section.id }}">
            <span class="tagline-pulse"></span>
            <span>{{ section.settings.top_tagline }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.cert_badge != blank -%}
          <div class="hero-nij-cert-badge-{{ section.id }}">
            {{ section.settings.cert_badge }}
          </div>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h1 class="hero-nij-title-{{ section.id }}">
            <span class="gradient-text">{{ section.settings.title }}</span>
          </h1>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <div class="hero-nij-subtitle-{{ section.id }}">
            {{ section.settings.subtitle }}
          </div>
        {%- endif -%}

        {%- if section.settings.highlight_text != blank -%}
          <div class="hero-nij-highlight-box-{{ section.id }}">
            <div class="highlight-icon">
              <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <span>{{ section.settings.highlight_text }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="hero-nij-description-{{ section.id }}">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        <!-- Botones CTA -->
        {%- if section.settings.btn_primary_label != blank or section.settings.btn_secondary_label != blank -%}
          <div class="hero-nij-actions-{{ section.id }}">
            {%- if section.settings.btn_primary_label != blank -%}
              <a href="{{ section.settings.btn_primary_link | default: '#' }}" class="hero-nij-btn-primary-{{ section.id }}">
                <span>{{ section.settings.btn_primary_label }}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            {%- endif -%}

            {%- if section.settings.btn_secondary_label != blank -%}
              <a href="{{ section.settings.btn_secondary_link | default: '#' }}" class="hero-nij-btn-secondary-{{ section.id }}">
                <span>{{ section.settings.btn_secondary_label }}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>

      <!-- Columna Visual / Imagen Destacada & Seal Badge -->
      <div class="hero-nij-media-{{ section.id }}">
        <div class="hero-nij-image-wrapper-{{ section.id }}">
          
          <div class="hero-nij-splash-overlay-{{ section.id }}"></div>

          {%- if section.settings.hero_image != blank -%}
            {{ section.settings.hero_image | image_url: width: 1200 | image_tag: 
              loading: 'eager', 
              class: 'hero-nij-image-', 
              alt: section.settings.title 
            }}
          {%- else -%}
            <img 
              src="https://images.unsplash.com/photo-1595590424283-b8f17842773f?auto=format&fit=crop&w=900&q=80" 
              alt="Certificación NIJ Balística Arsenal" 
              class="hero-nij-image-{{ section.id }}"
              width="900"
              height="1000"
              loading="eager"
            />
          {%- endif -%}

          <!-- Insignia Flotante de Certificado -->
          {%- if section.settings.show_seal_badge -%}
            <div class="hero-nij-seal-badge-{{ section.id }}">
              <div class="hero-nij-seal-icon-{{ section.id }}">
                <svg viewBox="0 0 24 24">
                  <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-5.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                </svg>
              </div>
              <div class="hero-nij-seal-text-{{ section.id }}">
                <span class="hero-nij-seal-tag-{{ section.id }}">{{ section.settings.seal_tag | default: 'CERTIFICADO' }}</span>
                <span class="hero-nij-seal-title-{{ section.id }}">{{ section.settings.seal_title | default: 'NIJ 0101.07' }}</span>
                <span class="hero-nij-seal-sub-{{ section.id }}">{{ section.settings.seal_subtitle | default: 'CALIDAD Y CONFIANZA' }}</span>
              </div>
            </div>
          {%- endif -%}

        </div>
      </div>

    </div>

    <!-- Pilares de Características (Bloques Dinámicos) -->
    {%- if section.blocks.size > 0 -%}
      <div class="hero-nij-pillars-container-{{ section.id }}">
        <div class="hero-nij-pillars-grid-{{ section.id }}">
          {%- for block in section.blocks -%}
            <div class="hero-nij-pillar-card-{{ section.id }}" {{ block.shopify_attributes }}>
              <div class="hero-nij-pillar-icon-{{ section.id }}">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-5.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
                  {%- when 'target' -%}
                    <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
                  {%- when 'tech' -%}
                    <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.93V18h-2v-1.07A6 6 0 0 1 6.07 13H5v-2h1.07A6 6 0 0 1 11 6.07V5h2v1.07A6 6 0 0 1 17.93 11H19v2h-1.07A6 6 0 0 1 13 16.93zM12 8a4 4 0 1 0 4 4 4 4 0 0 0-4-4z"/></svg>
                  {%- when 'trust' -%}
                    <svg viewBox="0 0 24 24"><path d="M18 10.5V6L9 1l-9 5v4.5C0 16.1 3.8 21 9 22.5c2.3-.7 4.3-2.1 5.8-4.1l-2.4-2.4c-1 1.2-2.1 2-3.4 2.5-3.3-1-5.8-4.5-5.8-8V7.2l6.8-3.8 6.8 3.8v3.3h2zm-2.8 1.4L11 16.1l-2.8-2.8 1.4-1.4 1.4 1.4 3.8-3.8 1.4 1.4z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24"><path d="M12 2L1 21h22L12 2zm0 3.5L20.5 19h-17L12 5.5zM11 10h2v4h-2zm0 5h2v2h-2z"/></svg>
                {%- endcase -%}
              </div>
              <div class="hero-nij-pillar-info-{{ section.id }}">
                <span class="hero-nij-pillar-title-{{ section.id }}">{{ block.settings.title }}</span>
                {%- if block.settings.description != blank -%}
                  <span class="hero-nij-pillar-desc-{{ section.id }}">{{ block.settings.description }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Hero Certificación NIJ",
  "tag": "section",
  "class": "section-hero-nij",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Diseño y Estructura"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ocupar Ancho Completo (Full Width)",
      "default": true,
      "info": "Elimina los márgenes laterales del tema para que el hero ocupe el 100% de la pantalla."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de la Imagen",
      "options": [
        { "value": "right", "label": "Derecha" },
        { "value": "left", "label": "Izquierda" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Ancho Máximo",
      "default": 1250
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "min": 500,
      "max": 900,
      "step": 50,
      "unit": "px",
      "label": "Altura Mínima Desktop",
      "default": 650
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Relleno Superior",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Relleno Inferior",
      "default": 60
    },
    {
      "type": "header",
      "content": "Contenido de Texto"
    },
    {
      "type": "text",
      "id": "top_tagline",
      "label": "Slogan / Hashtag Superior",
      "default": "#TuSeguridadEsNuestraPrioridad"
    },
    {
      "type": "text",
      "id": "cert_badge",
      "label": "Etiqueta Certificación",
      "default": "CERTIFICACIÓN"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título Principal",
      "default": "NIJ 0101.07"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo / Aplicación",
      "default": "EN PANELES BALÍSTICOS"
    },
    {
      "type": "inline_richtext",
      "id": "highlight_text",
      "label": "Texto Destacado de Hito / Logro Mundial",
      "default": "Somos de las 5 primeras empresas en el mundo en obtener la certificación NIJ 0101.07"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Descripción",
      "default": "Cumplimos con el más alto estándar internacional en protección balística. Nuestros paneles <strong>certificados</strong> brindan <strong>confianza, resistencia y tecnología de vanguardia</strong> para quienes protegen lo más importante."
    },
    {
      "type": "header",
      "content": "Botones de Acción"
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Texto Botón Principal",
      "default": "Ver Productos Certificados"
    },
    {
      "type": "url",
      "id": "btn_primary_link",
      "label": "Enlace Botón Principal"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Texto Botón Secundario",
      "default": "Conocer Más"
    },
    {
      "type": "url",
      "id": "btn_secondary_link",
      "label": "Enlace Botón Secundario"
    },
    {
      "type": "header",
      "content": "Imagen e Insignia"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagen del Producto Destacado"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Borde Redondeado de Imagen",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_seal_badge",
      "label": "Mostrar Insignia Flotante de Sello",
      "default": true
    },
    {
      "type": "text",
      "id": "seal_tag",
      "label": "Etiqueta del Sello",
      "default": "CERTIFICADO"
    },
    {
      "type": "text",
      "id": "seal_title",
      "label": "Título del Sello",
      "default": "NIJ 0101.07"
    },
    {
      "type": "text",
      "id": "seal_subtitle",
      "label": "Subtítulo del Sello",
      "default": "CALIDAD Y CONFIANZA"
    },
    {
      "type": "header",
      "content": "Colores y Estética"
    },
    {
      "type": "color",
      "id": "bg_color_1",
      "label": "Color de Fondo 1",
      "default": "#0b0c10"
    },
    {
      "type": "color",
      "id": "bg_color_2",
      "label": "Color de Fondo 2",
      "default": "#1a1c23"
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "deg",
      "label": "Ángulo del Gradiente",
      "default": 135
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del Título",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de Texto General",
      "default": "#E5E7EB"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de Acento Principal (Naranja)",
      "default": "#FF5500"
    },
    {
      "type": "color",
      "id": "secondary_accent",
      "label": "Color de Acento Secundario (Fuego)",
      "default": "#E64A19"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Fondo de Insignia Flotante",
      "default": "rgba(18, 20, 26, 0.85)"
    },
    {
      "type": "color",
      "id": "pillar_bg_color",
      "label": "Fondo de Pilares Inferiores",
      "default": "rgba(255, 255, 255, 0.03)"
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Redondeo de Botones",
      "default": 8
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Tamaño Título Desktop",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "feature_pillar",
      "name": "Pilar Destacado",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "shield", "label": "Protección / Escudo" },
            { "value": "target", "label": "Desempeño / Mira Balística" },
            { "value": "tech", "label": "Tecnología / Red Avanzada" },
            { "value": "trust", "label": "Compromiso / Confianza" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título del Pilar",
          "default": "PROTECCIÓN CERTIFICADA"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Descripción Breve",
          "default": "Estándares balísticos probados"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Certificación NIJ",
      "blocks": [
        {
          "type": "feature_pillar",
          "settings": {
            "icon": "shield",
            "title": "PROTECCIÓN CERTIFICADA",
            "description": "Estándar oficial NIJ 0101.07"
          }
        },
        {
          "type": "feature_pillar",
          "settings": {
            "icon": "target",
            "title": "ALTO DESEMPEÑO BALÍSTICO",
            "description": "Máxima resistencia a impactos"
          }
        },
        {
          "type": "feature_pillar",
          "settings": {
            "icon": "tech",
            "title": "TECNOLOGÍA AVANZADA",
            "description": "Paneles ultraligeros de vanguardia"
          }
        },
        {
          "type": "feature_pillar",
          "settings": {
            "icon": "trust",
            "title": "COMPROMISO Y CONFIANZA",
            "description": "Garantía de calidad para tu seguridad"
          }
        }
      ]
    }
  ]
}
{% endschema %}
