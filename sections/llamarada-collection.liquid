{%- paginate collection.products by section.settings.products_per_page -%}
<div class="ll-home">
  <!-- Reusable Sidebar with active category detection -->
  {% render 'llamarada-sidebar', active_handle: collection.handle %}

  <!-- Main Collection Canvas -->
  <main class="ll-canvas">
    <!-- 1. Category Hero Banner -->
    <section class="ll-category-hero" aria-label="{{ collection.title | default: 'Limpieza' }}">
      {%- if collection.image != blank -%}
        <img
          src="{{ collection.image | image_url: width: 1400 }}"
          alt="{{ collection.title | escape }}"
          class="ll-category-hero__bg"
          loading="eager"
          width="1400"
          height="256"
        >
      {%- elsif section.settings.banner_image != blank -%}
        <img
          src="{{ section.settings.banner_image | image_url: width: 1400 }}"
          alt="{{ collection.title | escape }}"
          class="ll-category-hero__bg"
          loading="eager"
          width="1400"
          height="256"
        >
      {%- else -%}
        <img
          src="{{ 'cat-banner-limpieza.png' | asset_url }}"
          alt="{{ collection.title | default: 'Limpieza' }}"
          class="ll-category-hero__bg"
          loading="eager"
          width="1400"
          height="256"
        >
      {%- endif -%}

      <div class="ll-category-hero__overlay">
        <h1 class="ll-category-hero__title">
          {{ collection.title | default: section.settings.fallback_title | default: 'Limpieza' }}
        </h1>
        <p class="ll-category-hero__subtitle">
          {%- if collection.description != blank -%}
            {{ collection.description | strip_html }}
          {%- else -%}
            {{ section.settings.fallback_description | default: 'Soluciones efectivas para un entorno impecable. Calidad industrial a tu alcance.' }}
          {%- endif -%}
        </p>
      </div>
    </section>

    <!-- 2. Collection Products Grid -->
    <section class="ll-products-grid" aria-label="Productos de la categoría">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          <article class="ll-cat-card">
            <!-- Badges -->
            <div class="ll-product-card__badges">
              {%- if product.available == false -%}
                <span class="ll-badge ll-badge--red">AGOTADO</span>
              {%- elsif product.compare_at_price > product.price -%}
                <span class="ll-badge ll-badge--red">DESCUENTO</span>
              {%- elsif product.tags contains 'nuevo' or product.tags contains 'Nuevo' -%}
                <span class="ll-badge ll-badge--green">NUEVO</span>
              {%- else -%}
                <span class="ll-badge ll-badge--green">EN STOCK</span>
              {%- endif -%}
            </div>

            <!-- Media -->
            <div class="ll-cat-card__media">
              {%- if product.featured_media != blank -%}
                <img
                  src="{{ product.featured_media | image_url: width: 400 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                  width="300"
                  height="211"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>

            <!-- Body -->
            <div class="ll-cat-card__body">
              <div>
                <h3 class="ll-cat-card__title">
                  <a href="{{ product.url }}" style="color: inherit; text-decoration: none;">
                    {{ product.title }}
                  </a>
                </h3>

                <!-- Packaging info (from metafield, tag or default) -->
                <p class="ll-cat-card__package-info">
                  {%- if product.metafields.custom.empaque != blank -%}
                    {{ product.metafields.custom.empaque }}
                  {%- else -%}
                    Caja mayorista
                  {%- endif -%}
                </p>
              </div>

              <div>
                <div class="ll-cat-card__price-row">
                  <div class="ll-cat-card__unit-price-wrap">
                    <span class="ll-cat-card__unit-price{% if product.compare_at_price > product.price %} ll-cat-card__unit-price--discount{% endif %}">
                      {{ product.price | money }}
                    </span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="ll-cat-card__unit-compare">
                        {{ product.compare_at_price | money }}
                      </span>
                    {%- endif -%}
                    <span class="ll-cat-card__unit-label">/pza</span>
                  </div>

                  <div class="ll-cat-card__box-total">
                    <span>Caja: {{ product.price | times: 12 | money_without_trailing_zeros }}</span>
                  </div>
                </div>

                <!-- Add button -->
                {%- if product.available -%}
                  <form method="post" action="/cart/add">
                    <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                    <button type="submit" class="ll-cat-card__btn">
                      <img src="{{ 'icon-cart-add.svg' | asset_url }}" alt="" width="14" height="14">
                      <span>Agregar</span>
                    </button>
                  </form>
                {%- else -%}
                  <button type="button" class="ll-cat-card__btn" disabled style="opacity: 0.6; cursor: not-allowed;">
                    <span>Agotado</span>
                  </button>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        <!-- DEMO SAMPLE PRODUCTS MATCHING FIGMA SPEC -->
        <!-- Product 1 -->
        <article class="ll-cat-card">
          <div class="ll-product-card__badges">
            <span class="ll-badge ll-badge--green">EN STOCK</span>
          </div>

          <div class="ll-cat-card__media">
            <img src="{{ 'prod-limpieza-1.png' | asset_url }}" alt="Set 3 Cepillos Limpieza Baño Colores Pastel" loading="lazy" width="300" height="211">
          </div>

          <div class="ll-cat-card__body">
            <div>
              <h3 class="ll-cat-card__title">
                Set 3 Cepillos Limpieza Baño Colores Pastel
              </h3>
              <p class="ll-cat-card__package-info">Caja con 24 pzas</p>
            </div>

            <div>
              <div class="ll-cat-card__price-row">
                <div class="ll-cat-card__unit-price-wrap">
                  <span class="ll-cat-card__unit-price">$45.00</span>
                  <span class="ll-cat-card__unit-label">/pza</span>
                </div>
                <div class="ll-cat-card__box-total">
                  <div>Caja:</div>
                  <div>$1,080</div>
                </div>
              </div>

              <a href="/products/set-cepillos-limpieza" class="ll-cat-card__btn">
                <img src="{{ 'icon-cart-add.svg' | asset_url }}" alt="" width="14" height="14">
                <span>Agregar</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Product 2 -->
        <article class="ll-cat-card">
          <div class="ll-product-card__badges">
            <span class="ll-badge ll-badge--red">DESCUENTO</span>
          </div>

          <div class="ll-cat-card__media">
            <img src="{{ 'prod-limpieza-2.png' | asset_url }}" alt="Cepillo Premium Acero Inoxidable Base Rosa" loading="lazy" width="300" height="211">
          </div>

          <div class="ll-cat-card__body">
            <div>
              <h3 class="ll-cat-card__title">
                Cepillo Premium Acero Inoxidable Base Rosa
              </h3>
              <p class="ll-cat-card__package-info">Caja con 12 pzas</p>
            </div>

            <div>
              <div class="ll-cat-card__price-row">
                <div class="ll-cat-card__unit-price-wrap">
                  <span class="ll-cat-card__unit-price ll-cat-card__unit-price--discount">$85.00</span>
                  <span class="ll-cat-card__unit-compare">$95.00</span>
                </div>
                <div class="ll-cat-card__box-total">
                  <div>Caja:</div>
                  <div>$1,020</div>
                </div>
              </div>

              <a href="/products/cepillo-premium-rosa" class="ll-cat-card__btn">
                <img src="{{ 'icon-cart-add.svg' | asset_url }}" alt="" width="14" height="14">
                <span>Agregar</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Product 3 -->
        <article class="ll-cat-card">
          <div class="ll-cat-card__media">
            <img src="{{ 'prod-limpieza-3.png' | asset_url }}" alt="Paquetes Paños Microfibra Industrial" loading="lazy" width="300" height="211">
          </div>

          <div class="ll-cat-card__body">
            <div>
              <h3 class="ll-cat-card__title">
                Paquetes Paños Microfibra Industrial…
              </h3>
              <p class="ll-cat-card__package-info">Fardo con 50 paq</p>
            </div>

            <div>
              <div class="ll-cat-card__price-row">
                <div class="ll-cat-card__unit-price-wrap">
                  <span class="ll-cat-card__unit-price">$22.50</span>
                  <span class="ll-cat-card__unit-label">/paq</span>
                </div>
                <div class="ll-cat-card__box-total">
                  <div>Fardo:</div>
                  <div>$1,125</div>
                </div>
              </div>

              <a href="/products/panos-microfibra" class="ll-cat-card__btn">
                <img src="{{ 'icon-cart-add.svg' | asset_url }}" alt="" width="14" height="14">
                <span>Agregar</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Product 4 -->
        <article class="ll-cat-card">
          <div class="ll-cat-card__media">
            <img src="{{ 'prod-limpieza-4.png' | asset_url }}" alt="Atomizador Industrial Translúcido 1 Litro" loading="lazy" width="300" height="211">
          </div>

          <div class="ll-cat-card__body">
            <div>
              <h3 class="ll-cat-card__title">
                Atomizador Industrial Translúcido 1 Litro
              </h3>
              <p class="ll-cat-card__package-info">Caja con 36 pzas</p>
            </div>

            <div>
              <div class="ll-cat-card__price-row">
                <div class="ll-cat-card__unit-price-wrap">
                  <span class="ll-cat-card__unit-price">$18.00</span>
                  <span class="ll-cat-card__unit-label">/pza</span>
                </div>
                <div class="ll-cat-card__box-total">
                  <span>Caja: $648</span>
                </div>
              </div>

              <a href="/products/atomizador-industrial" class="ll-cat-card__btn">
                <img src="{{ 'icon-cart-add.svg' | asset_url }}" alt="" width="14" height="14">
                <span>Agregar</span>
              </a>
            </div>
          </div>
        </article>
      {%- endif -%}
    </section>

    {%- if paginate.pages > 1 -%}
      <div class="ll-pagination" style="display: flex; justify-content: center; margin-top: 32px;">
        {{ paginate | default_pagination }}
      </div>
    {%- endif -%}
  </main>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Llamarada Collection",
  "class": "section-llamarada-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 16,
      "label": "Productos por página"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Imagen de banner alternativa"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Título por defecto",
      "default": "Limpieza"
    },
    {
      "type": "textarea",
      "id": "fallback_description",
      "label": "Descripción por defecto",
      "default": "Soluciones efectivas para un entorno impecable. Calidad industrial a tu alcance."
    }
  ],
  "presets": [
    {
      "name": "Llamarada Collection"
    }
  ]
}
{% endschema %}
